/* pages/history/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}
.top_bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
}
.clear_btn {
  font-size: 26rpx;
  color: #eb4450;
  padding: 8rpx 24rpx;
  border: 1rpx solid #eb4450;
  border-radius: 30rpx;
}
.history_groups { padding: 0 20rpx; }
.group_title {
  font-size: 26rpx;
  color: #999;
  padding: 16rpx 0 8rpx;
}
.history_card {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.delete_btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #eb4450;
  color: #fff;
  text-align: center;
  line-height: 160rpx;
  font-size: 26rpx;
}
.card_main {
  display: flex;
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  transition: transform 0.25s;
  position: relative;
  z-index: 2;
}
.history_img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}
.history_info { flex: 1; }
.history_name {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.history_bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 16rpx;
}
.history_price { color: #eb4450; font-size: 28rpx; font-weight: bold; }
.history_time { font-size: 22rpx; color: #999; }

.skeleton { padding: 20rpx; }
.sk_card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.sk_img { width: 140rpx; height: 140rpx; background: #eee; border-radius: 12rpx; margin-right: 20rpx; }
.sk_line { height: 24rpx; background: #eee; border-radius: 8rpx; margin-top: 16rpx; }
.w80 { width: 80%; }
.w60 { width: 60%; }
.breath { animation: breath 1.2s infinite ease-in-out; }
@keyframes breath {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
.empty_state { text-align: center; padding: 120rpx 0; }
.empty_icon { font-size: 100rpx; }
.empty_text { color: #999; margin: 20rpx 0; font-size: 28rpx; }
.empty_btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #eb4450;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}
