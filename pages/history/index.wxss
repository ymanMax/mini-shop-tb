/* pages/history/index.wxss */
page {
  background: #f5f5f5;
}
.history_page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.top_bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background: #fff;
}
.clear_all {
  font-size: 26rpx;
  color: #999;
}

.group_section {
  margin-bottom: 16rpx;
}
.group_title {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 24rpx 8rpx;
}
.group_list {
  background: #fff;
}
.history_item {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #f5f5f5;
}
.delete_btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #eb4450;
  color: #fff;
  text-align: center;
  line-height: 160rpx;
  font-size: 26rpx;
  z-index: 1;
}
.item_main {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  position: relative;
  z-index: 2;
  transition: transform 0.25s;
}
.item_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #eee;
}
.item_info {
  flex: 1;
  margin-left: 20rpx;
}
.item_name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}
.item_bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 12rpx;
}
.item_price {
  color: #eb4450;
  font-size: 30rpx;
  font-weight: bold;
}
.item_time {
  font-size: 22rpx;
  color: #999;
}
.empty_btn {
  margin-top: 30rpx;
  padding: 16rpx 60rpx;
  font-size: 26rpx;
}
