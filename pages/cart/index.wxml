<!--pages/cart/index.wxml —— 购物车-->
<view class="cart_page">
  <!-- 收货地址 -->
  <view class="address_card" bindtap="openAddress">
    <block wx:if="{{address.name}}">
      <view class="addr_icon">📍</view>
      <view class="addr_info">
        <view class="addr_line1">
          <text class="addr_name">{{address.name}}</text>
          <text class="addr_phone">{{address.phone}}</text>
        </view>
        <view class="addr_detail">{{address.region}} {{address.detail}}</view>
      </view>
      <view class="addr_arrow">›</view>
    </block>
    <block wx:else>
      <view class="addr_icon">📍</view>
      <view class="addr_info">
        <view class="addr_line1 addr_placeholder">请选择收货地址</view>
      </view>
      <view class="addr_arrow">›</view>
    </block>
  </view>

  <!-- 正常商品 -->
  <view wx:if="{{validItems.length > 0}}" class="cart_list">
    <view
      wx:for="{{validItems}}"
      wx:key="id"
      class="cart_item {{swipedId === item.id ? 'swiped' : ''}}"
      data-id="{{item.id}}"
      bindtouchstart="touchStart"
      bindtouchmove="touchMove"
      bindtouchend="touchEnd"
    >
      <!-- 删除按钮（左滑露出） -->
      <view class="delete_btn" catchtap="removeItem" data-id="{{item.id}}">删除</view>
      <view class="item_main" bindtap="closeSwipe">
        <view class="chk" catchtap="toggleItem" data-id="{{item.id}}">
          <view class="checkbox {{item.checked ? 'checked' : ''}}">{{item.checked ? '✓' : ''}}</view>
        </view>
        <image class="item_img" src="{{item.mainPic}}" mode="aspectFill" bindtap="previewImg" data-url="{{item.mainPic}}" binderror="handleImgError" data-list="validItems" data-idx="{{index}}" data-field="mainPic" />
        <view class="item_info">
          <view class="item_name">{{item.name}}</view>
          <view class="item_spec">{{item.specText}}</view>
          <view class="item_bottom">
            <view class="price"><text class="price-symbol">¥</text>{{item.price}}</view>
            <view class="stepper">
              <view class="step-btn" catchtap="changeCount" data-id="{{item.id}}" data-op="{{-1}}">−</view>
              <view class="step-num">{{item.count}}</view>
              <view class="step-btn" catchtap="changeCount" data-id="{{item.id}}" data-op="{{1}}">＋</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view wx:elif="{{!loading}}" class="empty-state">
    <view class="empty-icon">🛒</view>
    <view class="empty-text">购物车还是空的</view>
    <view class="btn-primary go_shop" bindtap="goShop">去逛逛</view>
  </view>

  <!-- 失效商品 -->
  <view wx:if="{{invalidItems.length > 0}}" class="invalid_section">
    <view class="invalid_header" bindtap="clearInvalid">
      <text>失效商品（{{invalidItems.length}}）</text>
      <text class="clear_invalid">🗑 清空</text>
    </view>
    <view class="invalid_item" wx:for="{{invalidItems}}" wx:key="id">
      <view class="chk disabled"><view class="checkbox"></view></view>
      <image class="item_img invalid_img" src="{{item.mainPic}}" mode="aspectFill" binderror="handleImgError" data-list="invalidItems" data-idx="{{index}}" data-field="mainPic" />
      <view class="item_info">
        <view class="item_name invalid_name">{{item.name}}</view>
        <view class="item_spec">{{item.specText}}</view>
        <view class="invalid_reason">{{item.invalidReason || '已下架'}}</view>
      </view>
    </view>
  </view>

  <!-- 猜你喜欢 -->
  <view wx:if="{{validItems.length > 0}}" class="recommend_section">
    <view class="rec_title">💝 猜你喜欢</view>
    <scroll-view scroll-x class="rec_scroll" scroll-hide>
      <view class="rec_item" wx:for="{{recommend}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image src="{{item.mainPic}}" mode="aspectFill" binderror="handleImgError" data-list="recommend" data-idx="{{index}}" data-field="mainPic" />
        <view class="rec_name">{{item.name}}</view>
        <view class="rec_price price">¥{{item.price}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部结算栏 -->
  <view wx:if="{{validItems.length > 0}}" class="footer_bar">
    <view class="all_chk" bindtap="toggleAll">
      <view class="checkbox {{allChecked ? 'checked' : ''}}">{{allChecked ? '✓' : ''}}</view>
      <text class="all_label">全选</text>
    </view>
    <view class="total_area">
      <view class="total_row">
        合计：<text class="price big"><text class="price-symbol">¥</text>{{totalPrice}}</text>
      </view>
      <view class="promo">满49减5 · 满99减10（已优惠自动计算）</view>
    </view>
    <view class="pay_btn" bindtap="handlePay">去结算({{totalCount}})</view>
  </view>
</view>

