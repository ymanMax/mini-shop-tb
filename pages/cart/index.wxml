<!--pages/cart/index.wxml-->
<view class="page">
  <!-- 收货地址区 -->
  <view class="address_card" bindtap="handleChooseAddress">
    <view class="addr_icon">📍</view>
    <view class="addr_info" wx:if="{{address}}">
      <view class="addr_row">
        <text class="addr_name">{{address.name}}</text>
        <text class="addr_phone">{{address.phone}}</text>
      </view>
      <view class="addr_detail">{{address.region}}{{address.detail}}</view>
    </view>
    <view class="addr_info" wx:else>
      <view class="addr_row">
        <text class="addr_name">请选择收货地址</text>
      </view>
    </view>
    <view class="addr_arrow" bindtap="handleAddAddress">＋</view>
  </view>

  <!-- 商品列表 -->
  <view class="section_title" wx:if="{{cart.length}}">已选商品 ({{cart.length}})</view>

  <view class="cart_list" wx:if="{{cart.length}}">
    <view
      class="cart_row"
      wx:for="{{cart}}"
      wx:key="id"
      bindtouchstart="handleTouchStart"
      bindtouchend="handleTouchEnd"
      data-id="{{item.id}}"
    >
      <!-- 删除按钮（左滑露出） -->
      <view class="delete_btn" bindtap="handleSwipeDelete" data-id="{{item.id}}">删除</view>
      <!-- 行内容 -->
      <view class="row_main" style="transform: translateX({{swipedId === item.id ? '-160rpx' : '0'}});">
        <view class="check_box {{item.checked ? 'checked' : ''}}" bindtap="handleItemChange" data-id="{{item.id}}">
          <text wx:if="{{item.checked}}">✓</text>
        </view>
        <image
          class="row_img"
          src="{{item.mainPic}}"
          mode="aspectFill"
          data-index="{{index}}"
          binderror="handleImgError"
        />
        <view class="row_info">
          <view class="row_name">{{item.name}}</view>
          <view class="row_spec">{{item.specText}}</view>
          <view class="row_bottom">
            <text class="row_price">{{item.priceText}}</text>
            <view class="stepper">
              <view class="stepper_btn" bindtap="handleItemNumEdit" data-id="{{item.id}}" data-operation="{{-1}}">−</view>
              <view class="stepper_num">{{item.count}}</view>
              <view class="stepper_btn" bindtap="handleItemNumEdit" data-id="{{item.id}}" data-operation="{{1}}">＋</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 失效商品 -->
  <view class="section_title" wx:if="{{invalidItems.length}}">失效商品 ({{invalidItems.length}})</view>
  <view class="invalid_list" wx:if="{{invalidItems.length}}">
    <view class="invalid_row" wx:for="{{invalidItems}}" wx:key="id">
      <view class="check_box disabled"></view>
      <image class="row_img" src="{{item.mainPic}}" mode="aspectFill" binderror="handleImgError" data-field="invalidItems[{{index}}].mainPic" />
      <view class="row_info">
        <view class="row_name disabled_text">{{item.name}}</view>
        <view class="row_spec">{{item.specText}}</view>
        <view class="row_bottom">
          <text class="row_price disabled_text">{{item.priceText}}</text>
          <text class="invalid_tag">已失效</text>
        </view>
      </view>
    </view>
    <view class="clear_invalid" bindtap="clearInvalid">清空失效商品</view>
  </view>

  <!-- 空态 -->
  <view class="empty_state" wx:if="{{!loading && !cart.length && !invalidItems.length}}">
    <view class="empty_icon">🛒</view>
    <view class="empty_text">购物车还是空的</view>
    <view class="empty_btn" bindtap="goHome">去逛逛</view>
  </view>

  <!-- 猜你喜欢 -->
  <view class="section_title" wx:if="{{recommends.length && cart.length}}">猜你喜欢</view>
  <scroll-view class="recommend_scroll" scroll-x wx:if="{{recommends.length && cart.length}}">
    <view class="recommend_item" wx:for="{{recommends}}" wx:key="id" bindtap="goRecommend" data-id="{{item.id}}">
      <image src="{{item.mainPic}}" mode="aspectFill" class="recommend_img" binderror="handleImgError" data-field="recommends[{{index}}].mainPic" />
      <view class="recommend_name">{{item.name}}</view>
      <view class="recommend_price">{{item.priceText}}</view>
    </view>
  </scroll-view>

  <!-- 底部结算栏 -->
  <view class="settle_bar" wx:if="{{cart.length}}">
    <view class="all_check" bindtap="handleAllChecked">
      <view class="check_box {{allChecked ? 'checked' : ''}}"><text wx:if="{{allChecked}}">✓</text></view>
      <text class="all_check_label">全选</text>
    </view>
    <view class="settle_info">
      <view class="total_row">
        <text class="total_label">合计：</text>
        <text class="total_price">{{payPriceText}}</text>
      </view>
      <view class="discount_row" wx:if="{{discount > 0}}">已减 {{discountText}}（满39减5/满99减15）</view>
    </view>
    <view class="settle_btn" bindtap="handlePay">去结算({{totalCount}})</view>
  </view>
</view>
