/* pages/cart/index.wxss */
.page {
  padding-bottom: 140rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 地址卡片 */
.address_card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.addr_icon { font-size: 36rpx; margin-right: 16rpx; }
.addr_info { flex: 1; }
.addr_row { display: flex; align-items: center; }
.addr_name { font-size: 30rpx; font-weight: bold; color: #333; }
.addr_phone { font-size: 26rpx; color: #666; margin-left: 20rpx; }
.addr_detail { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.addr_arrow {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  background: #eb4450;
  color: #fff;
  border-radius: 50%;
  font-size: 36rpx;
}

/* 区块标题 */
.section_title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 16rpx 24rpx;
}

/* 购物车行 */
.cart_list { background: #fff; }
.cart_row {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #f0f0f0;
}
.delete_btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #eb4450;
  color: #fff;
  text-align: center;
  line-height: 180rpx;
  font-size: 28rpx;
}
.row_main {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  transition: transform 0.25s;
  position: relative;
  z-index: 2;
}
.check_box {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
  color: #fff;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.check_box.checked {
  background: #eb4450;
  border-color: #eb4450;
}
.check_box.disabled {
  background: #eee;
  border-color: #ddd;
}
.row_img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.row_info { flex: 1; }
.row_name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.row_spec {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 8rpx;
  display: inline-block;
}
.row_bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.row_price { color: #eb4450; font-size: 32rpx; font-weight: bold; }
.stepper { display: flex; align-items: center; }
.stepper_btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 30rpx;
}
.stepper_num {
  width: 70rpx;
  text-align: center;
  font-size: 26rpx;
}

/* 失效商品 */
.invalid_list { background: #fff; padding: 0 20rpx; }
.invalid_row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  opacity: 0.7;
}
.disabled_text { color: #999 !important; text-decoration: line-through; }
.invalid_tag {
  font-size: 20rpx;
  color: #999;
  background: #eee;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}
.clear_invalid {
  text-align: center;
  color: #eb4450;
  font-size: 26rpx;
  padding: 24rpx 0;
}

/* 空态 */
.empty_state {
  padding: 120rpx 0;
  text-align: center;
}
.empty_icon { font-size: 120rpx; }
.empty_text { color: #999; margin: 20rpx 0; font-size: 28rpx; }
.empty_btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #eb4450;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

/* 推荐 */
.recommend_scroll { white-space: nowrap; padding: 16rpx 24rpx; }
.recommend_item {
  display: inline-block;
  width: 200rpx;
  margin-right: 16rpx;
  vertical-align: top;
}
.recommend_img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}
.recommend_name {
  font-size: 24rpx;
  color: #333;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recommend_price {
  color: #eb4450;
  font-size: 26rpx;
  font-weight: bold;
  margin-top: 4rpx;
}

/* 结算栏 */
.settle_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.all_check {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}
.all_check_label { font-size: 26rpx; color: #333; margin-left: 8rpx; }
.settle_info { flex: 1; }
.total_row { display: flex; align-items: baseline; }
.total_label { font-size: 26rpx; color: #333; }
.total_price { color: #eb4450; font-size: 36rpx; font-weight: bold; }
.discount_row { font-size: 20rpx; color: #ff6b35; }
.settle_btn {
  background: #eb4450;
  color: #fff;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}
