/* pages/cart/index.wxss */
page {
  background: #f5f5f5;
  padding-bottom: 140rpx;
}
.cart_page { padding-bottom: 140rpx; }

/* 地址卡片 */
.address_card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.addr_icon { font-size: 40rpx; margin-right: 16rpx; }
.addr_info { flex: 1; }
.addr_line1 { display: flex; align-items: center; gap: 16rpx; }
.addr_name { font-size: 30rpx; font-weight: 600; }
.addr_phone { font-size: 26rpx; color: #666; }
.addr_placeholder { color: #999; }
.addr_detail { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.addr_arrow { font-size: 40rpx; color: #ccc; }

/* 商品列表 */
.cart_list { margin: 0 20rpx; }
.cart_item {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.delete_btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: var(--themeColor);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.item_main {
  display: flex;
  padding: 20rpx;
  align-items: center;
  background: #fff;
  position: relative;
  z-index: 1;
  transition: transform 0.2s;
}
.cart_item.swiped .item_main {
  transform: translateX(-140rpx);
}
.chk {
  width: 56rpx;
  display: flex;
  justify-content: center;
}
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.checkbox.checked {
  background: var(--themeColor);
  border-color: var(--themeColor);
}
.chk.disabled .checkbox { background: #eee; border-color: #eee; }
.item_img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin: 0 16rpx;
}
.item_info { flex: 1; }
.item_name {
  font-size: 27rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 38rpx;
}
.item_spec {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin: 8rpx 0;
}
.item_bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.item_bottom .price { font-size: 32rpx; font-weight: 700; }
.item_bottom .price-symbol { font-size: 22rpx; }

/* 失效商品 */
.invalid_section {
  margin: 0 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.invalid_header {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #999;
  border-bottom: 1rpx solid #f5f5f5;
}
.clear_invalid { color: var(--themeColor); }
.invalid_item {
  display: flex;
  padding: 20rpx;
  align-items: center;
  opacity: 0.6;
}
.invalid_img { filter: grayscale(1); }
.invalid_name { color: #999; }
.invalid_reason { font-size: 22rpx; color: #eb4450; margin-top: 6rpx; }

/* 推荐 */
.recommend_section { margin: 20rpx; }
.rec_title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.rec_scroll { white-space: nowrap; }
.rec_item {
  display: inline-block;
  width: 200rpx;
  margin-right: 16rpx;
  vertical-align: top;
}
.rec_item image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}
.rec_name {
  font-size: 24rpx;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 34rpx;
}
.rec_price { font-size: 28rpx; font-weight: 600; }

/* 底部结算栏 */
.footer_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 110rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 80;
}
.all_chk {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.all_label { font-size: 26rpx; }
.total_area { flex: 1; text-align: right; margin-right: 20rpx; }
.total_row { font-size: 26rpx; color: #333; }
.total_row .price.big { font-size: 38rpx; }
.promo { font-size: 20rpx; color: #ff9500; }
.pay_btn {
  background: linear-gradient(90deg, #ff5b6a, #eb4450);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
}

/* 空态 */
.empty-state { padding: 140rpx 40rpx; }
.empty-state .empty-icon { font-size: 120rpx; }
.go_shop {
  padding: 16rpx 60rpx;
  font-size: 28rpx;
  display: inline-block;
  margin-top: 20rpx;
}

/* 地址弹层 */
.address_sheet { max-height: 70vh; }
.sheet_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.sheet_title { font-size: 32rpx; font-weight: 600; }
.sheet_close { font-size: 32rpx; color: #999; }
.addr_list { padding: 20rpx 28rpx; max-height: 50vh; }
.addr_option {
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.addr_option.active {
  border-color: var(--themeColor);
  background: var(--themeLight);
}
.default_tag {
  font-size: 20rpx;
  background: var(--themeColor);
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}
.addr_add {
  text-align: center;
  padding: 24rpx;
  color: var(--themeColor);
  font-size: 28rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
}
