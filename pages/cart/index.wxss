/* pages/cart/index.wxss */
page {
  background: #f5f5f5;
  padding-bottom: 120rpx;
}
.cart_page {
  min-height: 100vh;
}

/* 地址卡片 */
.address_card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}
.address_icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}
.address_info {
  flex: 1;
}
.address_top {
  display: flex;
  align-items: center;
}
.address_name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}
.address_phone {
  font-size: 26rpx;
  color: #666;
}
.address_detail {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.address_arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 区块标题 */
.section_title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 20rpx 24rpx;
}
.invalid_title {
  color: #999;
}

/* 购物车列表 */
.cart_list {
  background: #fff;
}
.cart_item {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #f5f5f5;
}
.item_main {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  transition: transform 0.25s;
  position: relative;
  z-index: 2;
}
.delete_btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #eb4450;
  color: #fff;
  text-align: center;
  line-height: 120rpx;
  font-size: 28rpx;
  z-index: 1;
}
.chk_wrap {
  width: 60rpx;
  display: flex;
  justify-content: center;
}
.chk {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
  color: #fff;
}
.chk.on {
  background: #eb4450;
  border-color: #eb4450;
}
.chk.disabled {
  background: #eee;
  border-color: #eee;
}
.item_img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin: 0 20rpx;
  background: #eee;
}
.item_info {
  flex: 1;
}
.item_name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}
.item_spec {
  font-size: 22rpx;
  color: #999;
  margin: 8rpx 0;
}
.item_bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.item_price {
  color: #eb4450;
  font-size: 32rpx;
  font-weight: bold;
}
.disabled_price {
  color: #bbb;
  text-decoration: line-through;
}
.invalid_tip {
  font-size: 22rpx;
  color: #eb4450;
  margin-left: 16rpx;
}
.stepper {
  display: flex;
  align-items: center;
}
.stepper_btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #f2f2f2;
  border-radius: 8rpx;
  font-size: 30rpx;
}
.stepper_num {
  width: 70rpx;
  text-align: center;
  font-size: 28rpx;
}

/* 失效商品 */
.cart_item.invalid {
  opacity: 0.6;
}
.clear_invalid {
  text-align: center;
  color: #eb4450;
  font-size: 26rpx;
  padding: 24rpx;
}

/* 推荐 */
.recommend_section {
  background: #fff;
  margin-top: 16rpx;
}
.recommend_bar {
  white-space: nowrap;
  padding: 0 24rpx 24rpx;
}
.recommend_inner {
  display: inline-flex;
}
.recommend_item {
  width: 200rpx;
  margin-right: 20rpx;
}
.recommend_img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}
.recommend_name {
  font-size: 24rpx;
  color: #333;
  margin-top: 8rpx;
}
.recommend_price {
  color: #eb4450;
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 4rpx;
}

/* 底部结算栏 */
.footer_tool {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 50;
}
.all_chk_wrap {
  display: flex;
  align-items: center;
}
.all_chk_text {
  font-size: 26rpx;
  color: #333;
  margin-left: 12rpx;
}
.total_wrap {
  flex: 1;
  margin-left: 24rpx;
}
.total_price {
  font-size: 26rpx;
  color: #333;
}
.total_price .price {
  color: #eb4450;
  font-size: 34rpx;
  font-weight: bold;
}
.discount_text {
  font-size: 20rpx;
  color: #ff9500;
}
.pay_btn {
  background: linear-gradient(90deg, #ff5a66, #eb4450);
  color: #fff;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

/* 空态按钮 */
.empty_btn {
  margin-top: 30rpx;
  padding: 16rpx 60rpx;
  font-size: 26rpx;
}

/* 地址面板 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.address_panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  z-index: 101;
  max-height: 70vh;
  transform: translateY(100%);
  transition: transform 0.3s;
  display: flex;
  flex-direction: column;
}
.address_panel.show {
  transform: translateY(0);
}
.panel_title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.address_list {
  max-height: 400rpx;
}
.address_item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.address_item_top {
  display: flex;
  align-items: center;
}
.default_badge {
  font-size: 20rpx;
  color: #eb4450;
  border: 1rpx solid #eb4450;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 16rpx;
}
.address_item_detail {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}
.panel_add_btn {
  margin-top: 24rpx;
  text-align: center;
  color: #eb4450;
  font-size: 28rpx;
  padding: 20rpx;
  border: 1rpx dashed #eb4450;
  border-radius: 12rpx;
}
.add_form {
  margin-top: 16rpx;
}
.form_row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form_label {
  width: 140rpx;
  font-size: 26rpx;
  color: #333;
}
.form_row input {
  flex: 1;
  font-size: 26rpx;
}
.form_btns {
  display: flex;
  margin-top: 24rpx;
}
.form_btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
}
.form_btn.cancel {
  background: #f2f2f2;
  color: #666;
  margin-right: 20rpx;
}
.form_btn.save {
  background: #eb4450;
  color: #fff;
}
