<!--pages/collect/index.wxml-->
<view class="collect_page">
  <!-- Tab 栏 -->
  <view class="tab_bar">
    <view
      class="tab_item {{activeTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="id"
      bindtap="onTabTap"
      data-index="{{index}}"
    >{{item.value}}</view>
  </view>

  <!-- 收藏列表 -->
  <view class="collect_list" wx:if="{{collect.length > 0}}">
    <view
      class="collect_item"
      wx:for="{{collect}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
    >
      <!-- 删除按钮（左滑露出） -->
      <view class="delete_btn" catchtap="removeCollect" data-id="{{item.id}}">取消收藏</view>
      <view class="item_main" style="transform: translateX({{swipeId === item.id ? '-180rpx' : '0'}});">
        <image class="collect_img" src="{{item.mainPic}}" mode="aspectFill" binderror="onImgError" data-index="{{index}}" />
        <view class="collect_info" bindtap="goDetail" data-id="{{item.id}}">
          <view class="collect_name ellipsis-2">{{item.name}}</view>
          <view class="collect_bottom">
            <text class="collect_price">{{item.priceText}}</text>
            <text class="original_price" wx:if="{{item.originalPrice > item.price}}">{{item.originalPriceText}}</text>
          </view>
          <view class="sales">已售{{item.sales}}件</view>
        </view>
        <view class="collect_mark">❤️</view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty-wrap" wx:if="{{collect.length === 0}}">
    <view class="empty-icon">🤍</view>
    <view class="empty-text">还没有收藏商品，去逛逛~</view>
    <view class="empty_btn btn-primary" bindtap="goHome">去逛逛</view>
  </view>
</view>
