/* pages/pay/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.card_title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

/* 地址 */
.card.addr_card {
  display: flex;
  align-items: center;
}
.addr_icon { font-size: 36rpx; margin-right: 16rpx; }
.addr_info { flex: 1; }
.addr_row { display: flex; align-items: center; }
.addr_name { font-size: 30rpx; font-weight: bold; color: #333; }
.addr_phone { font-size: 26rpx; color: #666; margin-left: 20rpx; }
.addr_detail { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.addr_arrow { font-size: 40rpx; color: #999; }

/* 商品 */
.item_row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.item_row:last-child { border-bottom: none; }
.item_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.item_info { flex: 1; }
.item_name {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item_spec {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 8rpx;
  display: inline-block;
}
.item_right { text-align: right; }
.item_price { color: #eb4450; font-size: 28rpx; font-weight: bold; }
.item_count { color: #999; font-size: 24rpx; margin-top: 4rpx; }

/* 金额 */
.money_row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #333;
}
.money_row.discount { color: #ff6b35; }
.money_row.total {
  border-top: 1rpx solid #eee;
  margin-top: 8rpx;
  padding-top: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}
.pay_amount { color: #eb4450; font-size: 32rpx; }

/* 支付栏 */
.pay_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.pay_btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #eb4450;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.pay_btn.disabled { opacity: 0.6; }

/* 优惠券行 */
.coupon_row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.coupon_label { font-size: 28rpx; color: #333; }
.coupon_value { font-size: 26rpx; color: #eb4450; }

/* 优惠券弹层 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
}
.coupon_panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.coupon_panel.open { transform: translateY(0); }
.panel_title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}
.panel_body { padding: 20rpx; flex: 1; }
.coupon_option {
  display: flex;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}
.coupon_option.selected {
  border-color: #eb4450;
  background: #fdf0f1;
}
.coupon_option.disabled { opacity: 0.5; }
.opt_left {
  width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  border-radius: 8rpx;
  margin-right: 16rpx;
}
.opt_right { flex: 1; }
.opt_name { font-size: 26rpx; font-weight: bold; color: #333; }
.opt_scope { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.opt_reason { font-size: 22rpx; color: #eb4450; margin-top: 4rpx; }
.empty_state { text-align: center; padding: 60rpx 0; }
.empty_icon { font-size: 80rpx; }
.empty_text { color: #999; margin: 16rpx 0; font-size: 26rpx; }
