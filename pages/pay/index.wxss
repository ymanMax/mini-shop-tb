/* pages/pay/index.wxss */
page { background: #f5f5f5; padding-bottom: 140rpx; }
.pay_page { padding-bottom: 140rpx; }

.address_card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.addr_icon { font-size: 40rpx; margin-right: 16rpx; }
.addr_info { flex: 1; }
.addr_line1 { display: flex; gap: 16rpx; }
.addr_name { font-size: 30rpx; font-weight: 600; }
.addr_phone { font-size: 26rpx; color: #666; }
.addr_detail { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.addr_placeholder { color: #999; font-size: 28rpx; }
.addr_arrow { font-size: 40rpx; color: #ccc; }

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}
.section_title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }

.g_row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.g_row:last-child { border-bottom: none; }
.g_img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.g_info { flex: 1; }
.g_name {
  font-size: 27rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 38rpx;
}
.g_spec { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.g_right { text-align: right; }
.g_price { font-size: 26rpx; color: #666; }

.amount_row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #666;
}
.amount_row.discount { color: #ff9500; }
.amount_row.total {
  border-top: 1rpx solid #f5f5f5;
  margin-top: 10rpx;
  padding-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.amount_row.total .big { font-size: 36rpx; }

.remark_input {
  width: 100%;
  height: 120rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.method_row {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}
.method_icon { font-size: 40rpx; margin-right: 16rpx; }
.method_name { flex: 1; font-size: 28rpx; }
.method_check { color: var(--themeColor); font-size: 32rpx; font-weight: 700; }

.footer_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 80;
}
.total_area { flex: 1; }
.total_row { font-size: 26rpx; }
.total_row .big { font-size: 38rpx; }
.pay_btn {
  background: linear-gradient(90deg, #ff5b6a, #eb4450);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0 60rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
}

/* ===== 优惠券选择 ===== */
.coupon_row { display: flex; justify-content: space-between; align-items: center; }
.coupon_select { display: flex; align-items: center; gap: 8rpx; }
.coupon_chosen { color: var(--themeColor); font-size: 26rpx; font-weight: 600; }
.coupon_hint { color: #999; font-size: 26rpx; }
.coupon_arrow { color: #ccc; }

.coupon_sheet { max-height: 75vh; }
.sheet_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.sheet_title { font-size: 32rpx; font-weight: 600; }
.sheet_close { font-size: 32rpx; color: #999; }
.coupon_sheet_body { padding: 20rpx; max-height: 60vh; }
.coupon_group_title {
  font-size: 26rpx;
  color: #999;
  padding: 16rpx 8rpx;
}
.coupon_option {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  padding: 16rpx;
  border: 2rpx solid transparent;
}
.coupon_option.selected { border-color: var(--themeColor); background: var(--themeLight); }
.coupon_option.disabled { opacity: 0.6; }
.co_left {
  width: 120rpx;
  height: 90rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  margin-right: 16rpx;
}
.co_left.type-red { background: linear-gradient(135deg, #ff5b6a, #eb4450); }
.co_left.type-orange { background: linear-gradient(135deg, #ffb400, #ff9500); }
.co_left.type-gold { background: linear-gradient(135deg, #ffd700, #ffae00); }
.co_value { font-size: 32rpx; font-weight: 800; }
.co_right { flex: 1; }
.co_name { font-size: 28rpx; font-weight: 600; }
.co_desc { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.co_check { font-size: 32rpx; color: var(--themeColor); font-weight: 700; }
.coupon_option.clear { justify-content: center; }
.clear_text { color: #666; font-size: 28rpx; }
