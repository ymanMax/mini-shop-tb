<!--pages/points/index.wxml-->
<view class="page">
  <!-- 头部积分卡 -->
  <view class="points_card">
    <view class="points_label">当前可用积分</view>
    <view class="points_value">{{points}}</view>
    <view class="checkin_entry" bindtap="goCheckin">
      <text>签到赚积分 ›</text>
    </view>
  </view>

  <!-- 积分兑换专区 -->
  <view class="section">
    <view class="section_title">积分兑换</view>
    <view class="exchange_list">
      <view class="exchange_item" wx:for="{{exchangeItems}}" wx:key="id">
        <view class="ex_left">
          <view class="ex_points">{{item.points}} 积分</view>
          <view class="ex_name">{{item.name}}</view>
          <view class="ex_desc">{{item.desc}}</view>
        </view>
        <view class="ex_btn {{points >= item.points ? '' : 'disabled'}}" bindtap="handleExchange" data-id="{{item.couponId || item.goodsId}}" data-points="{{item.points}}" data-name="{{item.name}}">
          {{points >= item.points ? '兑换' : '积分不够'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 积分明细 -->
  <view class="section">
    <view class="section_title">积分明细</view>
    <view class="records_list" wx:if="{{records.length}}">
      <view class="record_row" wx:for="{{records}}" wx:key="id">
        <view class="record_left">
          <view class="record_source">{{item.source}}</view>
          <view class="record_time">{{item.timeText}}</view>
        </view>
        <view class="record_amount {{item.type === 'earn' ? 'earn' : 'spend'}}">
          {{item.type === 'earn' ? '+' : ''}}{{item.amount}}
        </view>
      </view>
    </view>
    <view class="empty_state" wx:if="{{!loading && !records.length}}">
      <view class="empty_icon">📊</view>
      <view class="empty_text">暂无积分记录</view>
    </view>
  </view>
</view>
