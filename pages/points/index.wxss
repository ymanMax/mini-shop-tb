/* pages/points/index.wxss */
page { background: #f5f5f5; }
.points_page { padding-bottom: 40rpx; }

.points_header {
  background: linear-gradient(135deg, #ff5b6a, #eb4450);
  color: #fff;
  padding: 50rpx 30rpx;
  border-radius: 0 0 24rpx 24rpx;
  text-align: center;
}
.ph_points { font-size: 72rpx; font-weight: 800; }
.ph_label { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.ph_actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 24rpx;
}
.ph_btn {
  background: rgba(255,255,255,0.2);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}
.section_title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }

.exchange_grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ex_item {
  width: 48%;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}
.ex_cost { font-size: 36rpx; font-weight: 800; color: var(--themeColor); }
.ex_name { font-size: 26rpx; font-weight: 600; margin-top: 8rpx; }
.ex_desc { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.ex_btn {
  margin-top: 12rpx;
  background: var(--themeColor);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  display: inline-block;
}
.ex_btn.disabled { background: #ccc; }

.record_list { }
.record_item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.record_item:last-child { border-bottom: none; }
.r_left { flex: 1; }
.r_source { font-size: 26rpx; font-weight: 600; }
.r_desc { font-size: 24rpx; color: #666; margin-top: 4rpx; }
.r_time { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.r_change { font-size: 32rpx; font-weight: 700; }
.r_change.plus { color: var(--green, #52c41a); }
.r_change.minus { color: var(--themeColor); }
