/* pages/points/index.wxss */
page {
  background: #f5f5f5;
}
.points_page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头部积分卡 */
.points_header {
  background: linear-gradient(135deg, #ffb400, #ff8c00);
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #fff;
}
.points_balance {}
.balance_label {
  font-size: 26rpx;
  opacity: 0.9;
}
.balance_num {
  font-size: 64rpx;
  font-weight: bold;
  margin-top: 8rpx;
}
.checkin_entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 20rpx 32rpx;
}
.checkin_icon {
  font-size: 40rpx;
}
.checkin_text {
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 区块卡片 */
.section_card {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section_title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

/* 兑换专区 */
.exchange_grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.exchange_item {
  width: 48%;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  text-align: center;
}
.ex_points {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff8c00;
}
.ex_title {
  font-size: 26rpx;
  color: #333;
  margin-top: 8rpx;
}
.ex_desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.ex_btn {
  margin-top: 16rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffb400, #ff8c00);
  color: #fff;
  font-size: 24rpx;
}
.ex_btn.disabled {
  background: #ccc;
}

/* 积分明细 */
.record_list {}
.record_item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.record_item:last-child {
  border-bottom: none;
}
.record_source {
  font-size: 26rpx;
  color: #333;
}
.record_time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.record_points {
  font-size: 32rpx;
  font-weight: bold;
}
.record_points.plus {
  color: #52c41a;
}
.record_points.minus {
  color: #eb4450;
}
.no_more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx 0;
}
.loading_more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
}
