/* pages/seckill/index.wxss */
page { background: #f5f5f5; }
.seckill_page { padding-bottom: 40rpx; }

.sk_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #ff5b6a, #eb4450);
  color: #fff;
  border-radius: 0 0 24rpx 24rpx;
}
.sk_title { font-size: 36rpx; font-weight: 800; }
.countdown {
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  display: flex;
  gap: 8rpx;
  align-items: center;
}
.cd_label { font-size: 22rpx; opacity: 0.9; }
.cd_time { font-size: 30rpx; font-weight: 700; font-family: monospace; }

.session_bar { white-space: nowrap; padding: 20rpx; }
.session_item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  text-align: center;
  border: 1rpx solid #eee;
}
.session_item.active {
  background: var(--themeColor);
  color: #fff;
  border-color: var(--themeColor);
}
.session_hour { font-size: 28rpx; font-weight: 700; }
.session_name { font-size: 20rpx; opacity: 0.8; }

.goods_grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 20rpx;
}
.sk_card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.sk_card image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
}
.sk_name {
  font-size: 26rpx;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 36rpx;
  height: 72rpx;
}
.sk_price_row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin: 8rpx 0;
}
.sk_price { font-size: 34rpx; font-weight: 800; color: var(--themeColor); }
.sk_orig { font-size: 22rpx; color: #999; text-decoration: line-through; }
.progress_bar {
  height: 12rpx;
  background: #ffe0e0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress_fill {
  height: 100%;
  background: linear-gradient(90deg, #ff5b6a, #ff9500);
  border-radius: 6rpx;
}
.sk_meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  margin: 8rpx 0;
}
.sk_buy {
  text-align: center;
  background: linear-gradient(90deg, #ff5b6a, #eb4450);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx;
  border-radius: 999rpx;
}
.sk_buy.soldout { background: #ccc; }
