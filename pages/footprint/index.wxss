/* pages/footprint/index.wxss */
page {
  background: var(--bgPage);
}

/* ==================== 顶部统计栏 ==================== */
.foot_header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 32rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--borderColor);
}

.foot_count {
  font-size: 25rpx;
  color: var(--textSub);
}

.clear_btn {
  font-size: 25rpx;
  color: var(--themeColor);
  padding: 8rpx 4rpx;
}

.clear_btn.disabled {
  color: #ccc;
}

/* ==================== 骨架屏 ==================== */
.sk_wrap {
  padding: 20rpx;
}

.sk_item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.sk_img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.sk_info {
  flex: 1;
  margin-left: 24rpx;
}

.sk_line {
  height: 30rpx;
  margin-bottom: 18rpx;
}

.sk_line.short {
  width: 60%;
}

.sk_price {
  width: 140rpx;
  height: 40rpx;
  margin-top: 26rpx;
}

/* ==================== 日期分组 ==================== */
.group {
  margin-top: 12rpx;
}

.group_title {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 8rpx;
}

.group_dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--themeColor);
  margin-right: 14rpx;
}

.group_label {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--textMain);
}

.group_count {
  font-size: 22rpx;
  color: var(--textLight);
  margin-left: 12rpx;
}

/* ==================== 足迹行（左滑删除） ==================== */
.goods_row {
  position: relative;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--themeColor);
}

.row_delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  background: var(--themeColor);
  z-index: 1;
}

.goods_item {
  position: relative;
  z-index: 2;
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx;
  /* 跟手位移由内联 style 控制，这里只做松手后的回弹过渡 */
  transition: transform 0.2s ease;
}

.goods_img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.goods_info {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods_name {
  font-size: 27rpx;
  line-height: 38rpx;
  color: var(--textMain);
  height: 76rpx;
}

.goods_time {
  font-size: 22rpx;
  color: var(--textLight);
  margin-top: 8rpx;
}

.goods_bottom {
  display: flex;
  align-items: center;
  margin-top: auto;
}

.goods_price {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.price_symbol {
  font-size: 24rpx;
  color: var(--themeColor);
  font-weight: bold;
}

.price_now {
  font-size: 34rpx;
  color: var(--themeColor);
  font-weight: bold;
}

.add_btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b76, #eb4450);
  color: #fff;
  font-size: 34rpx;
  line-height: 48rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(235, 68, 80, 0.35);
}
