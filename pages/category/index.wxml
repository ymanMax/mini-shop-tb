<!--pages/category/index.wxml-->
<view class="cates">
  <!-- 顶部搜索栏 -->
  <view class="search_bar" bindtap="goSearch">
    <view class="search_inner">
      <text class="search_icon">🔍</text>
      <text class="search_placeholder">搜索烧饼、糕点、坚果…</text>
    </view>
  </view>

  <view class="cates_body">
    <!-- 左侧一级分类导航 -->
    <scroll-view class="left_menu" scroll-y>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="menu_item {{item.id === currentCatId ? 'active' : ''}}"
        bindtap="onCategoryTap"
        data-id="{{item.id}}"
        data-index="{{index}}"
      >
        <view class="menu_icon">{{item.icon}}</view>
        <view class="menu_name">{{item.name}}</view>
      </view>
    </scroll-view>

    <!-- 右侧内容 -->
    <view class="right_content">
      <!-- 二级分类标签栏 -->
      <scroll-view class="sub_bar" scroll-x>
        <view class="sub_inner">
          <view
            class="sub_tag {{activeSubId === 0 ? 'active' : ''}}"
            bindtap="onSubTap"
            data-id="{{0}}"
          >全部</view>
          <view
            wx:for="{{subList}}"
            wx:key="id"
            class="sub_tag {{item.id === activeSubId ? 'active' : ''}}"
            bindtap="onSubTap"
            data-id="{{item.id}}"
          >{{item.name}}</view>
        </view>
      </scroll-view>

      <!-- 吸顶筛选栏 -->
      <view class="filter_bar">
        <view class="sort_item {{sort === 'default' ? 'active' : ''}}" bindtap="onSortTap" data-sort="default">综合</view>
        <view class="sort_item {{sort === 'priceAsc' ? 'active' : ''}}" bindtap="onSortTap" data-sort="priceAsc">价格↑</view>
        <view class="sort_item {{sort === 'priceDesc' ? 'active' : ''}}" bindtap="onSortTap" data-sort="priceDesc">价格↓</view>
        <view class="sort_item {{sort === 'sales' ? 'active' : ''}}" bindtap="onSortTap" data-sort="sales">销量</view>
        <view class="sort_item filter_btn" bindtap="openFilter">
          筛选 <text class="filter_arrow">▾</text>
        </view>
      </view>

      <!-- 商品区 -->
      <view class="goods_area">
        <!-- 骨架屏 -->
        <view class="skeleton_grid" wx:if="{{skeleton}}">
          <view class="skeleton_card" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this">
            <view class="skeleton skeleton_img"></view>
            <view class="skeleton skeleton_line w80"></view>
            <view class="skeleton skeleton_line w60"></view>
            <view class="skeleton skeleton_line w40"></view>
          </view>
        </view>

        <!-- 商品网格 -->
        <view class="goods_grid" wx:else>
          <view class="goods_card" wx:for="{{goodsList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
            <view class="goods_img_wrap">
              <image src="{{item.mainPic}}" mode="aspectFill" binderror="onImgError" data-index="{{index}}" />
            </view>
            <view class="goods_info">
              <view class="goods_name ellipsis-2">{{item.name}}</view>
              <view class="goods_tags" wx:if="{{item.tags && item.tags.length}}">
                <text class="goods_tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
              </view>
              <view class="goods_bottom">
                <view class="price_wrap">
                  <text class="price">{{item.priceText}}</text>
                  <text class="original_price" wx:if="{{item.originalPrice > item.price}}">{{item.originalPriceText}}</text>
                </view>
                <view class="sales">已售{{item.sales}}件</view>
              </view>
              <view class="add_cart" catchtap="addToCart" data-item="{{item}}">＋</view>
            </view>
          </view>
        </view>

        <!-- 空态 -->
        <view class="empty-wrap" wx:if="{{!skeleton && goodsList.length === 0}}">
          <view class="empty-icon">🫓</view>
          <view class="empty-text">暂无符合条件的商品</view>
          <view class="empty_btn btn-outline" bindtap="clearFilter">清除筛选</view>
        </view>

        <!-- 到底提示 -->
        <view class="no_more" wx:if="{{!skeleton && goodsList.length > 0 && noMore}}">—— 没有更多了 ——</view>
        <view class="loading_more" wx:if="{{loading && goodsList.length > 0}}">加载中…</view>
      </view>
    </view>
  </view>

  <!-- 半屏筛选面板 -->
  <view class="mask" wx:if="{{showFilter}}" bindtap="closeFilter"></view>
  <view class="filter_panel {{showFilter ? 'show' : ''}}">
    <view class="panel_title">筛选</view>
    <view class="panel_row">
      <view class="panel_label">价格区间</view>
      <view class="price_inputs">
        <input type="digit" placeholder="最低价" value="{{priceMin}}" bindinput="onPriceMin" />
        <text class="price_dash">—</text>
        <input type="digit" placeholder="最高价" value="{{priceMax}}" bindinput="onPriceMax" />
      </view>
    </view>
    <view class="panel_row">
      <view class="panel_label">仅看有货</view>
      <switch checked="{{onlyStock}}" bindchange="toggleStock" color="#eb4450" />
    </view>
    <view class="panel_btns">
      <view class="panel_btn reset" bindtap="resetFilter">重置</view>
      <view class="panel_btn apply" bindtap="applyFilter">确定</view>
    </view>
  </view>
</view>
