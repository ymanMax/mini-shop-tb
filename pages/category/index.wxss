/* pages/category/index.wxss */
page {
  height: 100%;
  background: #f5f5f5;
}
.cates {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 搜索栏 */
.search_bar {
  padding: 16rpx 24rpx;
  background: #fff;
}
.search_inner {
  display: flex;
  align-items: center;
  background: #f2f2f2;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
}
.search_icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}
.search_placeholder {
  color: #999;
  font-size: 26rpx;
}

.cates_body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧菜单 */
.left_menu {
  width: 180rpx;
  background: #f7f7f7;
  height: 100%;
}
.menu_item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  font-size: 24rpx;
  color: #555;
  border-left: 6rpx solid transparent;
}
.menu_item.active {
  color: #eb4450;
  background: #fff;
  border-left-color: #eb4450;
  font-weight: bold;
}
.menu_icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* 右侧 */
.right_content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 二级分类标签 */
.sub_bar {
  background: #fff;
  white-space: nowrap;
  padding: 16rpx 0;
}
.sub_inner {
  display: inline-flex;
  padding: 0 20rpx;
}
.sub_tag {
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
  background: #f2f2f2;
}
.sub_tag.active {
  background: #eb4450;
  color: #fff;
}

/* 筛选栏 */
.filter_bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}
.sort_item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #555;
}
.sort_item.active {
  color: #eb4450;
  font-weight: bold;
}
.filter_btn {
  color: #555;
}
.filter_arrow {
  font-size: 20rpx;
}

/* 商品区 */
.goods_area {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
}
.goods_grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.goods_card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  position: relative;
}
.goods_img_wrap {
  width: 100%;
  height: 320rpx;
}
.goods_img_wrap image {
  width: 100%;
  height: 100%;
}
.goods_info {
  padding: 16rpx;
}
.goods_name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  min-height: 72rpx;
}
.goods_tags {
  margin: 8rpx 0;
}
.goods_tag {
  display: inline-block;
  font-size: 20rpx;
  color: #eb4450;
  border: 1rpx solid #eb4450;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
}
.goods_bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.price {
  color: #eb4450;
  font-size: 34rpx;
  font-weight: bold;
}
.original_price {
  color: #999;
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 8rpx;
}
.sales {
  color: #999;
  font-size: 20rpx;
}
.add_cart {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  background: #eb4450;
  color: #fff;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: bold;
}

/* 骨架屏 */
.skeleton_grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.skeleton_card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}
.skeleton_img {
  width: 100%;
  height: 300rpx;
  margin-bottom: 16rpx;
}
.skeleton_line {
  height: 24rpx;
  margin-bottom: 12rpx;
}
.w80 { width: 80%; }
.w60 { width: 60%; }
.w40 { width: 40%; }

.no_more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx 0;
}
.loading_more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
}
.empty_btn {
  margin-top: 30rpx;
  padding: 16rpx 60rpx;
  font-size: 26rpx;
}

/* 筛选面板 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}
.filter_panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s;
}
.filter_panel.show {
  transform: translateY(0);
}
.panel_title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}
.panel_row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.panel_label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
}
.price_inputs {
  flex: 1;
  display: flex;
  align-items: center;
}
.price_inputs input {
  width: 200rpx;
  background: #f2f2f2;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  text-align: center;
}
.price_dash {
  margin: 0 20rpx;
  color: #999;
}
.panel_btns {
  display: flex;
  margin-top: 40rpx;
}
.panel_btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
}
.panel_btn.reset {
  background: #f2f2f2;
  color: #666;
  margin-right: 20rpx;
}
.panel_btn.apply {
  background: #eb4450;
  color: #fff;
}
