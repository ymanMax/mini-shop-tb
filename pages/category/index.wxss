/* pages/category/index.wxss */
page {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.cate_page {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.cate_container {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧菜单 */
.left_menu {
  width: 180rpx;
  height: 100%;
  background: #f7f7f7;
}
.left_menu .menu_item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 10rpx;
  font-size: 26rpx;
  color: #555;
  border-left: 6rpx solid transparent;
}
.left_menu .menu_item .menu_icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.left_menu .menu_item.active {
  color: var(--themeColor);
  background: #fff;
  border-left-color: var(--themeColor);
  font-weight: 600;
}

/* 右侧 */
.right_content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #fff;
}
.sub_bar {
  white-space: nowrap;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.sub_bar .sub_item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 999rpx;
}
.sub_bar .sub_item.active {
  color: #fff;
  background: var(--themeColor);
}

/* 筛选栏 */
.filter_bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.filter_bar .sort_item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #555;
}
.filter_bar .sort_item.active {
  color: var(--themeColor);
  font-weight: 600;
}
.filter_bar .filter_btn {
  flex: 0 0 140rpx;
  text-align: center;
  font-size: 27rpx;
  color: #555;
  border-left: 1rpx solid #f0f0f0;
}
.filter_bar .filter_btn.active {
  color: var(--themeColor);
}

/* 商品区 */
.goods_area {
  flex: 1;
  height: 0;
  padding: 16rpx;
}
.goods_grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.goods_card {
  position: relative;
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.goods_card .goods_img_wrap {
  width: 100%;
  height: 320rpx;
  background: #f5f5f5;
}
.goods_card .goods_img_wrap image {
  width: 100%;
  height: 100%;
}
.goods_card .goods_info {
  padding: 16rpx;
}
.goods_card .goods_name {
  font-size: 27rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 76rpx;
  line-height: 38rpx;
}
.goods_card .goods_tags {
  margin: 8rpx 0;
  min-height: 32rpx;
}
.goods_card .goods_bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.goods_card .sales {
  font-size: 22rpx;
  color: #999;
}
.goods_card .add_btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--themeColor);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 骨架屏 */
.skeleton_list .sk_card {
  display: flex;
  padding: 16rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
}
.skeleton_list .sk_img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.skeleton_list .sk_info {
  flex: 1;
  margin-left: 20rpx;
  padding-top: 10rpx;
}
.skeleton_list .sk_line {
  height: 24rpx;
  margin-bottom: 16rpx;
}
.sk_line.w80 { width: 80%; }
.sk_line.w60 { width: 60%; }
.sk_line.w40 { width: 40%; }

.no_more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx 0;
}
.loading_tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx;
}
.clear_btn {
  padding: 12rpx 40rpx;
  font-size: 26rpx;
}

/* 筛选面板 */
.filter_sheet {
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.sheet_title {
  font-size: 32rpx;
  font-weight: 600;
}
.sheet_close {
  font-size: 32rpx;
  color: #999;
}
.sheet_body {
  padding: 28rpx;
}
.filter_group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
.filter_label {
  font-size: 28rpx;
  color: #333;
}
.price_range {
  display: flex;
  align-items: center;
}
.price_range input {
  width: 180rpx;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
}
.price_range .dash {
  margin: 0 16rpx;
  color: #999;
}
.sheet_footer {
  display: flex;
  padding: 20rpx 28rpx;
  gap: 20rpx;
}
.reset_btn, .apply_btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}
