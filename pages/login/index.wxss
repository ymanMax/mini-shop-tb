/* pages/login/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login_card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin: 40rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}
.logo { font-size: 100rpx; }
.title { font-size: 40rpx; font-weight: bold; color: #333; margin-top: 20rpx; }
.subtitle { font-size: 26rpx; color: #999; margin-top: 8rpx; }
.login_btn {
  margin-top: 60rpx;
  background: #eb4450;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.tip { font-size: 22rpx; color: #bbb; margin-top: 30rpx; }
