/* pages/login/index.wxss */
page { background: #f5f5f5; }
.login_page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.login_logo { font-size: 120rpx; }
.login_title { font-size: 40rpx; font-weight: 700; margin-top: 20rpx; color: #333; }
.login_sub { font-size: 26rpx; color: #999; margin-top: 12rpx; }
.login_btn {
  width: 80%;
  margin-top: 80rpx;
  background: var(--themeColor);
  border-radius: 999rpx;
  font-size: 30rpx;
}
.guest_btn {
  margin-top: 30rpx;
  color: #999;
  font-size: 26rpx;
  padding: 20rpx;
}
