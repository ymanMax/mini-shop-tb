/* pages/coupon/index.wxss */
page {
  background: var(--bgPage);
}

.page {
  padding: 24rpx 24rpx 40rpx;
}

/* ================= 我的优惠券入口 ================= */
.mine-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ff6b76, #eb4450);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(235, 68, 80, 0.25);
}

.mine-left {
  position: relative;
  display: flex;
  align-items: center;
}

.mine-icon {
  margin-right: 14rpx;
  font-size: 38rpx;
}

.mine-label {
  font-size: 30rpx;
  font-weight: 600;
}

.mine-badge {
  top: -16rpx;
  right: -30rpx;
  background: #ffffff;
  color: var(--themeColor);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.mine-right {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.mine-tip {
  opacity: 0.92;
}

.mine-arrow {
  margin-left: 10rpx;
  font-size: 36rpx;
  line-height: 1;
}

/* ================= 券卡 ================= */
.coupon-card {
  position: relative;
  display: flex;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 左侧面额区 */
.coupon-left {
  position: relative;
  width: 220rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  color: #ffffff;
  border-radius: 16rpx 0 0 16rpx;
}

/* 半圆缺口：与页面底色同色，营造券卡被剪裁的造型（纯 CSS，不用图片） */
.coupon-left::before,
.coupon-left::after {
  content: '';
  position: absolute;
  right: -14rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--bgPage);
  z-index: 2;
}

.coupon-left::before {
  top: -14rpx;
}

.coupon-left::after {
  bottom: -14rpx;
}

/* 三种类型不同的渐变背景色块 */
.card-full .coupon-left {
  background: linear-gradient(135deg, #ff6b6b, #eb4450);
}

.card-discount .coupon-left {
  background: linear-gradient(135deg, #ffb35c, #ff8a3d);
}

.card-none .coupon-left {
  background: linear-gradient(135deg, #ffd76a, #f5a623);
}

.coupon-amount {
  display: flex;
  align-items: baseline;
}

.coupon-symbol {
  font-size: 30rpx;
  font-weight: 600;
}

.coupon-value {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
  font-family: "DIN Alternate", -apple-system, sans-serif;
}

.coupon-unit {
  margin-left: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.coupon-threshold {
  margin-top: 12rpx;
  font-size: 22rpx;
  opacity: 0.95;
}

/* 右侧信息区 */
.coupon-right {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-left: 2rpx dashed rgba(235, 68, 80, 0.15);
}

.card-discount .coupon-right {
  border-left-color: rgba(255, 138, 61, 0.25);
}

.card-none .coupon-right {
  border-left-color: rgba(245, 166, 35, 0.3);
}

.coupon-info {
  flex: 1;
  min-width: 0;
  padding-right: 150rpx;
}

.coupon-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--textMain);
  line-height: 40rpx;
}

.coupon-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 22rpx;
}

.coupon-scope {
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
  border-radius: 6rpx;
  color: var(--themeColor);
  background: var(--themeColorFade);
}

.card-discount .coupon-scope {
  color: #ff8a3d;
  background: rgba(255, 138, 61, 0.12);
}

.card-none .coupon-scope {
  color: #d99a13;
  background: rgba(245, 166, 35, 0.15);
}

.coupon-days {
  color: var(--textLight);
}

.coupon-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--textLight);
  line-height: 32rpx;
}

/* 领取按钮，垂直居中悬浮在右侧 */
.coupon-btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  min-width: 132rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  background: linear-gradient(90deg, #ff6b76, #eb4450);
}

.card-discount .coupon-btn {
  background: linear-gradient(90deg, #ffb35c, #ff8a3d);
}

.card-none .coupon-btn {
  background: linear-gradient(90deg, #ffd76a, #f5a623);
}

/* 已领取 / 已领完：置灰不可点 */
.coupon-btn-disabled {
  background: #e6e6e6 !important;
  color: #b0b0b0 !important;
}

/* ================= 骨架屏 ================= */
.sk-card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 26rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.sk-face {
  width: 180rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.sk-info {
  flex: 1;
  margin-left: 24rpx;
}

.sk-line {
  height: 28rpx;
  margin-bottom: 20rpx;
}

.sk-line:last-child {
  margin-bottom: 0;
}

.sk-w60 {
  width: 60%;
}

.sk-w40 {
  width: 40%;
}

.sk-w30 {
  width: 30%;
}
