/* pages/coupon/index.wxss */
page { background: #f5f5f5; }
.coupon_page { padding-bottom: 40rpx; }

/* ===== 领券中心 ===== */
.center_header {
  background: linear-gradient(135deg, #ff5b6a, #eb4450);
  color: #fff;
  padding: 40rpx 30rpx;
  border-radius: 0 0 24rpx 24rpx;
  position: relative;
}
.center_title { font-size: 36rpx; font-weight: 800; }
.center_sub { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }
.go_mine {
  position: absolute;
  right: 30rpx;
  top: 40rpx;
  font-size: 26rpx;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.tpl_list { padding: 20rpx; }
.tpl_card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.tpl_left {
  width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 10rpx;
  color: #fff;
}
.type-red .tpl_left { background: linear-gradient(135deg, #ff5b6a, #eb4450); }
.type-orange .tpl_left { background: linear-gradient(135deg, #ffb400, #ff9500); }
.type-gold .tpl_left { background: linear-gradient(135deg, #ffd700, #ffae00); }
.tpl_value { font-size: 48rpx; font-weight: 800; }
.tpl_type { font-size: 22rpx; opacity: 0.9; margin-top: 4rpx; }
.tpl_right {
  flex: 1;
  padding: 24rpx;
  position: relative;
}
.tpl_name { font-size: 30rpx; font-weight: 600; }
.tpl_desc { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.tpl_scope { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.tpl_receive {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: var(--themeColor);
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}
.tpl_receive.claimed { background: #ccc; }

/* ===== 我的券 ===== */
.mine_tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #f0f0f0;
}
.mine_tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #555;
}
.mine_tab.active {
  color: var(--themeColor);
  font-weight: 600;
  border-bottom: 4rpx solid var(--themeColor);
}
.mine_list { padding: 20rpx; }
.mine_card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.mine_left {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 10rpx;
  color: #fff;
}
.mine_card.status-used .mine_left,
.mine_card.status-expired .mine_left { background: #bbb !important; }
.mine_right {
  flex: 1;
  padding: 24rpx;
  position: relative;
}
.mine_footer {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 8rpx;
}
.validity { font-size: 22rpx; color: #999; }
.expiring {
  font-size: 20rpx;
  color: #fff;
  background: #ff9500;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.use_btn {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: var(--themeColor);
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
}
.used_tag, .expired_tag {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.empty-state .empty-icon { font-size: 100rpx; }
