/* pages/order/index.wxss */
page { background: #f5f5f5; }
.order_page { padding-bottom: 40rpx; }

.tabs_bar {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab_item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #555;
}
.tab_item.active {
  color: var(--themeColor);
  font-weight: 600;
  border-bottom: 4rpx solid var(--themeColor);
}

.order_list { padding: 20rpx; }
.order_card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.order_no { font-size: 24rpx; color: #999; }
.status_badge {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.status-1 { color: #fff; background: var(--themeColor); }
.status-2 { color: #fff; background: var(--orange); }
.status-3 { color: #fff; background: var(--blue); }
.status-4 { color: #fff; background: var(--blue); }
.status-5 { color: #fff; background: var(--green); }
.status-6 { color: #999; background: #eee; }

.goods_rows { padding: 16rpx 0; }
.goods_row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.g_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.g_info { flex: 1; }
.g_name {
  font-size: 27rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 38rpx;
}
.g_spec { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.g_right { text-align: right; }
.g_price { font-size: 28rpx; font-weight: 600; }
.g_count { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.more_items {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  padding-top: 8rpx;
}

.card_footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx solid #f5f5f5;
}
.order_time { font-size: 22rpx; color: #999; }
.amount { font-size: 26rpx; color: #333; }
.amount .big { font-size: 34rpx; }

.card_actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  flex-wrap: wrap;
}
.act_btn {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
}
.disabled_text { color: #bbb; }

.no_more { text-align: center; color: #999; font-size: 24rpx; padding: 30rpx 0; }
.loading_tip { text-align: center; color: #999; font-size: 24rpx; padding: 20rpx; }

/* 骨架屏 */
.sk_list { padding: 20rpx; }
.sk_card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.sk_line { height: 28rpx; margin-bottom: 16rpx; border-radius: 6rpx; }
.sk_line.w40 { width: 40%; }
.sk_line.w80 { width: 80%; }
.sk_line.w60 { width: 60%; }

.empty-state .empty-icon { font-size: 100rpx; }
.go_shop { padding: 16rpx 60rpx; font-size: 28rpx; display: inline-block; margin-top: 20rpx; }
