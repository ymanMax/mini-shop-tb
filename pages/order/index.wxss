/* pages/order/index.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ============ 状态 Tab（吸顶） ============ */
.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.tab-item {
  position: relative;
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--textSub);
}

.tab-item.on {
  color: var(--themeColor);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  width: 44rpx;
  height: 6rpx;
  margin-left: -22rpx;
  border-radius: 6rpx;
  background: var(--themeColor);
}

/* ============ 数量概览 ============ */
.count-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 20rpx 0;
  padding: 20rpx 10rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.count-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.count-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--themeColor);
  line-height: 44rpx;
}

.count-label {
  font-size: 22rpx;
  color: var(--textLight);
}

/* ============ 订单卡片 ============ */
.list {
  padding: 16rpx 20rpx 0;
}

.order-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--textLight);
}

.status-badge {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

.st-pay {
  color: #eb4450;
  background: rgba(235, 68, 80, 0.1);
}

.st-deliver {
  color: #ff9500;
  background: rgba(255, 149, 0, 0.12);
}

.st-receive {
  color: #2f7cf6;
  background: rgba(47, 124, 246, 0.12);
}

.st-done {
  color: #28a745;
  background: rgba(40, 167, 69, 0.12);
}

.st-cancel {
  color: #999999;
  background: #f0f0f0;
}

/* 单商品行 */
.goods-row {
  display: flex;
  align-items: flex-start;
}

.goods-thumb {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.goods-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 140rpx;
}

.goods-name {
  font-size: 28rpx;
  color: var(--textMain);
  line-height: 38rpx;
}

.goods-spec {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--textLight);
}

.goods-price {
  display: flex;
  align-items: baseline;
}

.goods-price .price {
  font-size: 32rpx;
}

.goods-count {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: var(--textSub);
}

/* 多商品缩略图行 */
.thumb-row {
  display: flex;
  align-items: center;
}

.thumb-row .goods-thumb {
  margin-right: 16rpx;
}

.thumb-more {
  width: 100rpx;
  height: 140rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f5f5f5;
  color: var(--textLight);
  font-size: 26rpx;
}

.thumb-count {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--textSub);
}

/* 底部实付 + 时间 */
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--borderColor);
}

.foot-amount {
  font-size: 26rpx;
  color: var(--textSub);
}

.foot-amount .price-amount {
  font-size: 34rpx;
}

.foot-time {
  font-size: 24rpx;
  color: var(--textLight);
}

/* 操作按钮区 */
.card-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.act-btn {
  min-width: 140rpx;
  height: 60rpx;
  padding: 0 28rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--textSub);
  border: 1rpx solid #dddddd;
  border-radius: 999rpx;
}

.act-primary {
  color: #ffffff;
  background: linear-gradient(90deg, #ff6b76, #eb4450);
  border-color: transparent;
}

.act-cancel {
  color: var(--themeColor);
  border-color: rgba(235, 68, 80, 0.4);
}

.act-disabled {
  color: #cccccc;
  border-color: #eeeeee;
}

/* ============ 骨架屏 ============ */
.skeleton-card {
  margin: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.sk-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sk-line {
  height: 28rpx;
}

.sk-w40 {
  width: 40%;
}

.sk-w60 {
  width: 60%;
}

.sk-w30 {
  width: 30%;
}

.sk-badge {
  width: 100rpx;
  height: 36rpx;
  border-radius: 999rpx;
}

.sk-body {
  display: flex;
  margin-top: 24rpx;
}

.sk-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
}

.sk-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.sk-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}
