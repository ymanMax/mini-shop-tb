/* pages/order/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.order_list { padding: 20rpx; }
.order_card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.order_head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.order_no { font-size: 24rpx; color: #999; }
.order_status { font-size: 26rpx; font-weight: bold; }
.status_1 { color: #eb4450; }
.status_2 { color: #ff9500; }
.status_3 { color: #1e88e5; }
.status_4 { color: #1e88e5; }
.status_5 { color: #4caf50; }
.status_6 { color: #999; }

.order_items { padding: 16rpx 0; }
.order_item {
  display: flex;
  padding: 12rpx 0;
}
.item_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.item_info { flex: 1; }
.item_name {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item_spec {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 8rpx;
  display: inline-block;
}
.item_bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}
.item_price { color: #eb4450; font-size: 28rpx; font-weight: bold; }
.item_count { color: #999; font-size: 24rpx; }
.more_items {
  font-size: 22rpx;
  color: #999;
  text-align: right;
  padding-top: 8rpx;
}

.order_foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.order_time { font-size: 22rpx; color: #999; }
.pay_label { font-size: 24rpx; color: #666; }
.pay_amount { color: #eb4450; font-size: 32rpx; font-weight: bold; }

.order_actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.action_btn {
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  color: #333;
  border: 1rpx solid #ccc;
  border-radius: 30rpx;
}
.action_btn.primary {
  background: #eb4450;
  color: #fff;
  border-color: #eb4450;
}

.no_more {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 30rpx 0;
}

/* 骨架屏 */
.skeleton { padding: 20rpx; }
.sk_card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.sk_line {
  height: 28rpx;
  background: #eee;
  border-radius: 8rpx;
  margin-top: 16rpx;
}
.w90 { width: 90%; }
.w60 { width: 60%; }
.w80 { width: 80%; }
.breath { animation: breath 1.2s infinite ease-in-out; }
@keyframes breath {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* 空态 */
.empty_state {
  padding: 120rpx 0;
  text-align: center;
}
.empty_icon { font-size: 100rpx; }
.empty_text { color: #999; margin: 20rpx 0; font-size: 28rpx; }
.empty_btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #eb4450;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}
