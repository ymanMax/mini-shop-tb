/* pages/order/review.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.card_title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

/* 商品信息 */
.goods_row {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
}
.goods_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.goods_info { flex: 1; }
.goods_name {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.goods_spec { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.goods_price { color: #eb4450; font-size: 28rpx; font-weight: bold; }

/* 星级 */
.star_row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}
.star {
  font-size: 56rpx;
  color: #ddd;
  margin-right: 12rpx;
}
.star.on { color: #ffb400; }
.star_text { font-size: 26rpx; color: #666; margin-left: 16rpx; }

/* 标签 */
.tag_list {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 0;
}
.quick_tag {
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
  border: 2rpx solid transparent;
}
.quick_tag.active {
  background: #fdf0f1;
  color: #eb4450;
  border-color: #eb4450;
}

/* 输入框 */
.content_input {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  font-size: 26rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}
.word_count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 晒图 */
.upload_list {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 0;
}
.upload_item {
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.upload_item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.remove_btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
}
.upload_add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.add_icon { font-size: 48rpx; color: #999; }
.add_text { font-size: 22rpx; color: #999; margin-top: 8rpx; }

/* 提交 */
.submit_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.submit_btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #eb4450;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
}
.submit_btn.disabled { opacity: 0.6; }
