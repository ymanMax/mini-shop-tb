/* pages/order/review.wxss */
page {
  background: var(--bgPage);
  padding-bottom: 0;
}

/* ================= 骨架屏 ================= */
.sk-page {
  padding: 24rpx;
}

.sk-block {
  width: 100%;
  margin-bottom: 24rpx;
}

.sk-tip {
  height: 72rpx;
}

.sk-card {
  height: 420rpx;
  border-radius: 16rpx;
}

/* ================= 顶部提示条 ================= */
.tip-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: var(--themeColorFade);
  border-bottom: 1rpx solid rgba(235, 68, 80, 0.12);
}

.tip-no {
  font-size: 26rpx;
  color: var(--textSub);
}

.tip-point {
  font-size: 24rpx;
  color: var(--themeColor);
  font-weight: 600;
  padding: 4rpx 18rpx;
  background: #fff;
  border-radius: 999rpx;
}

/* ================= 评价块 ================= */
.review-block {
  margin: 24rpx;
  padding: 24rpx;
  background: var(--bgCard);
  border-radius: 16rpx;
}

.goods-row {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
}

.goods-pic {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.goods-pic image {
  width: 100%;
  height: 100%;
}

.goods-meta {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 140rpx;
}

.goods-name {
  font-size: 28rpx;
  color: var(--textMain);
  line-height: 40rpx;
}

.goods-spec {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--textLight);
}

/* ================= 星级 ================= */
.rate-row {
  display: flex;
  align-items: center;
  margin: 28rpx 0 24rpx;
}

.stars {
  display: flex;
  align-items: center;
}

.star {
  font-size: 56rpx;
  line-height: 1;
  margin-right: 12rpx;
}

.star-on {
  color: #ffb400;
}

.star-off {
  color: #d8d8d8;
}

.rate-text {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--themeColor);
  font-weight: 500;
}

/* ================= 标签 ================= */
.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag-item {
  font-size: 24rpx;
  color: var(--textSub);
  padding: 10rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--borderColor);
  background: #fafafa;
  transition: all 0.15s;
}

.tag-item-on {
  color: var(--themeColor);
  border-color: var(--themeColor);
  background: var(--themeColorFade);
}

/* ================= 文字输入 ================= */
.content-wrap {
  margin-top: 12rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.content-input {
  width: 100%;
  height: 160rpx;
  font-size: 26rpx;
  color: var(--textMain);
  line-height: 40rpx;
}

.content-placeholder {
  color: #bcbcbc;
  font-size: 26rpx;
}

.content-counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--textLight);
}

/* ================= 晒图 ================= */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.img-cell {
  position: relative;
  width: 154rpx;
  height: 154rpx;
  margin: 0 18rpx 18rpx 0;
  border-radius: 12rpx;
  overflow: visible;
}

.img-cell image {
  width: 154rpx;
  height: 154rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.img-loading {
  position: absolute;
  left: 0;
  top: 0;
  width: 154rpx;
  height: 154rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
}

.spinner {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 8rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.img-del {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 34rpx;
  z-index: 2;
}

.img-add {
  width: 154rpx;
  height: 154rpx;
  border-radius: 12rpx;
  border: 1rpx dashed #d0d0d0;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.img-add-plus {
  font-size: 56rpx;
  line-height: 1;
  color: #bbb;
}

.img-add-num {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--textLight);
}

/* ================= 底部提交 ================= */
.submit-placeholder {
  height: 140rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid var(--borderColor);
  z-index: 10;
}

.submit-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(90deg, #ff6b76, #eb4450);
}

.submit-btn-disabled {
  opacity: 0.6;
}
