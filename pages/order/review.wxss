/* pages/order/review.wxss */
page {
  background: #f5f5f5;
  padding-bottom: 120rpx;
}
.review_page {
  min-height: 100vh;
}

/* 区块卡片 */
.section_card {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section_title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

/* 商品项 */
.item_row {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.item_row.active {
  border-color: #eb4450;
  background: #fff5f6;
}
.item_img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #eee;
}
.item_info {
  flex: 1;
  margin-left: 20rpx;
}
.item_name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}
.item_spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.item_radio {
  font-size: 32rpx;
  color: #eb4450;
  margin-left: 16rpx;
}

/* 星级 */
.star_row {
  display: flex;
  align-items: center;
}
.big_star {
  font-size: 64rpx;
  color: #ddd;
  margin-right: 16rpx;
}
.big_star.on {
  color: #ffb400;
}
.star_label {
  font-size: 26rpx;
  color: #666;
  margin-left: 16rpx;
}

/* 标签 */
.tag_list {
  display: flex;
  flex-wrap: wrap;
}
.tag_option {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #f2f2f2;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid transparent;
}
.tag_option.active {
  background: #fff5f6;
  color: #eb4450;
  border-color: #eb4450;
}

/* 文字输入 */
.content_input {
  width: 100%;
  height: 200rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.word_count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 晒图 */
.upload_list {
  display: flex;
  flex-wrap: wrap;
}
.upload_item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}
.upload_img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.upload_remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
}
.upload_add {
  width: 160rpx;
  height: 160rpx;
  border: 1rpx dashed #ccc;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.add_icon {
  font-size: 48rpx;
  color: #ccc;
}
.add_text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 底部提交栏 */
.footer_tool {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 50;
}
.submit_btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(90deg, #ff5a66, #eb4450);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}
.submit_btn.disabled {
  opacity: 0.6;
}
