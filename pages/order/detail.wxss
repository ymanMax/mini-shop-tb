/* pages/order/detail.wxss */
.detail {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ============ 状态头部 ============ */
.status-header {
  padding: 48rpx 40rpx 60rpx;
  background: linear-gradient(135deg, #ff6b76 0%, #eb4450 100%);
  color: #ffffff;
  border-radius: 0 0 32rpx 32rpx;
}

.status-icon {
  font-size: 72rpx;
  line-height: 1;
}

.status-text {
  margin-top: 20rpx;
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.status-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

/* ============ 通用卡片 ============ */
.card {
  margin: 12rpx 20rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--textMain);
  margin-bottom: 20rpx;
}

.card-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--textLight);
}

/* ============ 物流信息 ============ */
.logi-status {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--themeColor);
}

.logi-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.logi-company {
  font-size: 26rpx;
  color: var(--textMain);
}

.logi-no {
  display: flex;
  align-items: center;
}

.logi-no-text {
  font-size: 24rpx;
  color: var(--textSub);
}

.copy-btn {
  margin-left: 16rpx;
  padding: 2rpx 16rpx;
  font-size: 22rpx;
  color: var(--themeColor);
  border: 1rpx solid rgba(235, 68, 80, 0.4);
  border-radius: 999rpx;
}

/* 竖向 timeline */
.timeline {
  padding-left: 6rpx;
}

.tl-item {
  display: flex;
}

.tl-axis {
  width: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-dot {
  width: 20rpx;
  height: 20rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 4rpx solid #d8d8d8;
  box-sizing: border-box;
}

.tl-dot.done {
  background: var(--themeColor);
  border-color: var(--themeColor);
  box-shadow: 0 0 0 6rpx var(--themeColorFade);
}

.tl-line {
  flex: 1;
  width: 4rpx;
  min-height: 40rpx;
  background: #e6e6e6;
}

.tl-line.done {
  background: var(--themeColor);
}

.tl-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 32rpx;
}

.tl-item:last-child .tl-body {
  padding-bottom: 0;
}

.tl-text {
  font-size: 28rpx;
  color: var(--textLight);
  font-weight: 400;
}

.tl-text.done {
  color: var(--themeColor);
  font-weight: 600;
}

.tl-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--textLight);
  line-height: 34rpx;
}

.tl-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #bbbbbb;
}

.advance-btn {
  margin-top: 24rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--themeColor);
  background: var(--themeColorFade);
  border: 1rpx dashed rgba(235, 68, 80, 0.5);
  border-radius: 12rpx;
}

/* ============ 收货地址 ============ */
.address-card {
  display: flex;
  align-items: flex-start;
}

.addr-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-right: 16rpx;
}

.addr-body {
  flex: 1;
  min-width: 0;
}

.addr-line1 {
  display: flex;
  align-items: center;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--textMain);
}

.addr-tel {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--textSub);
}

.addr-all {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--textSub);
  line-height: 38rpx;
}

/* ============ 商品清单 ============ */
.goods-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--borderColor);
}

.goods-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.gi-thumb {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.gi-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 150rpx;
}

.gi-name {
  font-size: 28rpx;
  color: var(--textMain);
  line-height: 38rpx;
}

.gi-spec {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--textLight);
}

.gi-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gi-price {
  display: flex;
  align-items: baseline;
}

.gi-price .price {
  font-size: 32rpx;
}

.gi-count {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: var(--textSub);
}

.gi-subtotal {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--textMain);
}

/* ============ 金额明细 ============ */
.amt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.amt-label {
  font-size: 28rpx;
  color: var(--textSub);
}

.amt-value {
  font-size: 28rpx;
  color: var(--textMain);
}

.amt-discount {
  color: var(--themeColor);
}

.amt-divider {
  height: 1rpx;
  margin: 10rpx 0;
  background: var(--borderColor);
}

.amt-label-final {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--textMain);
}

.amt-final-price {
  font-size: 42rpx;
}

/* ============ 订单信息 ============ */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--textSub);
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: var(--textMain);
  text-align: right;
}

.info-value-copy {
  display: flex;
  align-items: center;
}

.info-text {
  font-size: 28rpx;
  color: var(--textMain);
}

/* ============ 底部操作栏 ============ */
.bar-placeholder {
  height: 120rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.bar-btn {
  min-width: 180rpx;
  height: 76rpx;
  margin-left: 20rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--textSub);
  border: 1rpx solid #dddddd;
  border-radius: 999rpx;
}

.bar-primary {
  color: #ffffff;
  background: linear-gradient(90deg, #ff6b76, #eb4450);
  border-color: transparent;
}

/* ============ 骨架屏 ============ */
.detail-skeleton {
  padding: 20rpx;
}

.sk-header {
  height: 260rpx;
  margin: -20rpx -20rpx 0;
  border-radius: 0 0 32rpx 32rpx;
}

.sk-card {
  height: 220rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
}
