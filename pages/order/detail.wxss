/* pages/order/detail.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 状态头部 */
.status_header {
  padding: 60rpx 32rpx;
  text-align: center;
  color: #fff;
}
.status_bg_1 { background: linear-gradient(135deg, #eb4450, #ff6b6b); }
.status_bg_2 { background: linear-gradient(135deg, #ff9500, #ffb74d); }
.status_bg_3 { background: linear-gradient(135deg, #1e88e5, #42a5f5); }
.status_bg_4 { background: linear-gradient(135deg, #1e88e5, #42a5f5); }
.status_bg_5 { background: linear-gradient(135deg, #4caf50, #66bb6a); }
.status_bg_6 { background: linear-gradient(135deg, #999, #bbb); }
.status_icon { font-size: 80rpx; }
.status_title { font-size: 36rpx; font-weight: bold; margin-top: 16rpx; }
.status_desc { font-size: 24rpx; margin-top: 8rpx; opacity: 0.9; }

/* 卡片 */
.card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.card_title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.logistics_company { font-size: 22rpx; color: #999; font-weight: normal; }

/* 时间线 */
.timeline { padding: 24rpx 0; }
.tl_item {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}
.tl_item:last-child { padding-bottom: 0; }
.tl_dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ddd;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 8rpx;
  position: relative;
}
.tl_item.done .tl_dot {
  background: #eb4450;
}
.tl_item.done .tl_dot::after {
  content: '';
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  background: rgba(235, 68, 80, 0.2);
}
.tl_content { flex: 1; }
.tl_text { font-size: 26rpx; color: #333; }
.tl_item:not(.done) .tl_text { color: #999; }
.tl_time { font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* 地址 */
.addr_row { display: flex; align-items: center; padding-top: 16rpx; }
.addr_name { font-size: 30rpx; font-weight: bold; color: #333; }
.addr_phone { font-size: 26rpx; color: #666; margin-left: 20rpx; }
.addr_detail { font-size: 26rpx; color: #666; margin-top: 8rpx; line-height: 1.6; }

/* 商品清单 */
.item_row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.item_row:last-child { border-bottom: none; }
.item_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.item_info { flex: 1; }
.item_name {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item_spec {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 8rpx;
  display: inline-block;
}
.item_right { text-align: right; }
.item_price { color: #eb4450; font-size: 28rpx; font-weight: bold; }
.item_count { color: #999; font-size: 24rpx; margin-top: 4rpx; }

/* 金额明细 */
.money_row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #333;
}
.money_row.discount { color: #ff6b35; }
.money_row.total {
  border-top: 1rpx solid #eee;
  margin-top: 8rpx;
  padding-top: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}
.pay_amount { color: #eb4450; font-size: 32rpx; }

/* 订单信息 */
.info_row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
}
.info_label { color: #999; }
.info_value { color: #333; }

/* 模拟配送 */
.simulate_bar {
  padding: 0 24rpx;
}
.simulate_btn {
  text-align: center;
  background: #fff3ee;
  color: #ff6b35;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

/* 底部操作栏 */
.bottom_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 24rpx;
  gap: 16rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.action_btn {
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #ccc;
  border-radius: 36rpx;
}
.action_btn.primary {
  background: #eb4450;
  color: #fff;
  border-color: #eb4450;
}

/* 骨架屏 */
.sk_card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
}
.sk_line {
  height: 28rpx;
  background: #eee;
  border-radius: 8rpx;
  margin-top: 16rpx;
}
.w90 { width: 90%; }
.w60 { width: 60%; }
.w80 { width: 80%; }
.breath { animation: breath 1.2s infinite ease-in-out; }
@keyframes breath {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
