/* pages/order/detail.wxss */
page {
  background: #f5f5f5;
  padding-bottom: 120rpx;
}
.detail_page {
  min-height: 100vh;
}

/* 状态头部 */
.status_header {
  background: linear-gradient(135deg, #eb4450, #ff6b78);
  color: #fff;
  padding: 60rpx 32rpx;
  text-align: center;
  border-radius: 0 0 24rpx 24rpx;
}
.status_icon {
  font-size: 80rpx;
}
.status_text {
  font-size: 40rpx;
  font-weight: bold;
  margin-top: 16rpx;
}
.status_desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 区块卡片 */
.section_card {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section_title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

/* 物流 */
.logistics_info {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.logistics_company {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.logistics_no {
  font-size: 24rpx;
  color: #999;
}
.timeline {
  padding: 24rpx 0;
}
.tl_node {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}
.tl_node:last-child {
  padding-bottom: 0;
}
.tl_dot {
  width: 40rpx;
  font-size: 32rpx;
  color: #ddd;
  text-align: center;
  flex-shrink: 0;
}
.tl_node.done .tl_dot {
  color: #eb4450;
}
.tl_content {
  flex: 1;
  padding-left: 16rpx;
}
.tl_title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}
.tl_node:not(.done) .tl_title {
  color: #999;
  font-weight: normal;
}
.tl_desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}
.tl_time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 地址 */
.addr_row {
  display: flex;
  align-items: center;
}
.addr_name {
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 20rpx;
}
.addr_phone {
  font-size: 26rpx;
  color: #666;
}
.addr_detail {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* 商品清单 */
.goods_row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.goods_row:last-child {
  border-bottom: none;
}
.goods_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #eee;
}
.goods_info {
  flex: 1;
  margin-left: 20rpx;
}
.goods_name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}
.goods_spec {
  font-size: 22rpx;
  color: #999;
  margin: 8rpx 0;
}
.goods_bottom {
  display: flex;
  align-items: baseline;
}
.goods_price {
  color: #eb4450;
  font-size: 28rpx;
  font-weight: bold;
}
.goods_count {
  color: #999;
  font-size: 24rpx;
  margin-left: 16rpx;
}
.goods_subtotal {
  margin-left: auto;
  color: #333;
  font-size: 28rpx;
  font-weight: bold;
}

/* 金额明细 */
.amount_row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #666;
}
.amount_row.total {
  border-top: 1rpx solid #f5f5f5;
  margin-top: 12rpx;
  padding-top: 20rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}
.discount {
  color: #ff9500;
}
.pay_amount {
  color: #eb4450;
  font-size: 34rpx;
  font-weight: bold;
}

/* 订单信息 */
.info_row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.info_label {
  color: #999;
}
.info_value {
  color: #333;
}
.copy_link {
  color: #eb4450;
  font-size: 24rpx;
  margin-left: 12rpx;
}

/* 模拟按钮 */
.simulate_card {
  border: 1rpx dashed #ff9500;
}
.simulate_btns {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sim_btn {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #fff7e6;
  color: #ff9500;
  font-size: 26rpx;
  border: 1rpx solid #ff9500;
}
.sim_tip {
  font-size: 24rpx;
  color: #999;
  align-self: center;
}

/* 底部操作栏 */
.bottom_bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 50;
  gap: 16rpx;
}
.bar_btn {
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}
.bar_btn.primary {
  background: #eb4450;
  color: #fff;
}
.bar_btn.outline {
  border: 1rpx solid #eb4450;
  color: #eb4450;
}
