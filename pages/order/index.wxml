<!--pages/order/index.wxml-->
<view class="order_page">
  <!-- 状态 Tab -->
  <view class="tab_bar">
    <view
      class="tab_item {{activeTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="id"
      bindtap="onTabTap"
      data-index="{{index}}"
    >{{item.value}}</view>
  </view>

  <!-- 骨架屏 -->
  <view class="skeleton_list" wx:if="{{skeleton}}">
    <view class="skeleton_card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton skeleton_line w40"></view>
      <view class="skeleton skeleton_row">
        <view class="skeleton skeleton_img"></view>
        <view class="skeleton skeleton_col">
          <view class="skeleton skeleton_line w80"></view>
          <view class="skeleton skeleton_line w60"></view>
        </view>
      </view>
      <view class="skeleton skeleton_line w50"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order_list" wx:else>
    <view class="order_card" wx:for="{{orders}}" wx:key="id">
      <!-- 订单头 -->
      <view class="order_head" bindtap="goDetail" data-id="{{item.id}}">
        <view class="order_no">订单号：{{item.orderNo}}</view>
        <view class="order_status" style="color: {{item.statusColor}};">{{item.statusText}}</view>
      </view>

      <!-- 商品行 -->
      <view class="goods_row" bindtap="goDetail" data-id="{{item.id}}">
        <image class="goods_img" src="{{item.firstItem.mainPic}}" mode="aspectFill" binderror="onImgError" data-index="{{index}}" />
        <view class="goods_info">
          <view class="goods_name ellipsis-2">{{item.firstItem.name}}</view>
          <view class="goods_spec">{{item.firstItem.specText}}</view>
          <view class="goods_price_row">
            <text class="goods_price">{{item.firstItem.priceText}}</text>
            <text class="goods_count">×{{item.firstItem.count}}</text>
          </view>
        </view>
      </view>
      <view class="more_items" wx:if="{{item.items.length > 1}}">共 {{item.itemCount}} 件商品</view>

      <!-- 金额与时间 -->
      <view class="order_meta">
        <view class="meta_time">下单时间：{{item.createTimeText}}</view>
        <view class="meta_pay">实付：<text class="pay_amount">{{item.payAmountText}}</text></view>
      </view>

      <!-- 操作按钮 -->
      <view class="order_actions">
        <!-- 待付款 -->
        <block wx:if="{{item.status === 1}}">
          <view class="action_btn outline" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</view>
          <view class="action_btn primary" bindtap="goPay" data-id="{{item.id}}">去支付</view>
        </block>
        <!-- 待发货 -->
        <block wx:if="{{item.status === 2}}">
          <view class="action_btn outline" bindtap="urgeOrder" data-id="{{item.id}}">催发货</view>
        </block>
        <!-- 配送中/待收货 -->
        <block wx:if="{{item.status === 3 || item.status === 4}}">
          <view class="action_btn outline" bindtap="goDetail" data-id="{{item.id}}">查看物流</view>
          <view class="action_btn primary" bindtap="confirmReceive" data-id="{{item.id}}">确认收货</view>
        </block>
        <!-- 已完成 -->
        <block wx:if="{{item.status === 5}}">
          <view class="action_btn outline" wx:if="{{!item.isReviewed}}" bindtap="goReview" data-id="{{item.id}}">去评价</view>
          <view class="action_btn outline" bindtap="reorder" data-id="{{item.id}}">再来一单</view>
        </block>
        <!-- 已取消 -->
        <block wx:if="{{item.status === 6}}">
          <view class="action_btn disabled">已取消</view>
        </block>
        <!-- 查看详情（所有状态） -->
        <view class="action_btn ghost" bindtap="goDetail" data-id="{{item.id}}">查看详情</view>
      </view>
    </view>

    <!-- 到底提示 -->
    <view class="no_more" wx:if="{{noMore && orders.length > 0}}">—— 没有更多了 ——</view>

    <!-- 空态 -->
    <view class="empty-wrap" wx:if="{{orders.length === 0}}">
      <view class="empty-icon">📦</view>
      <view class="empty-text">{{tabs[activeTab].value === '全部' ? '还没有订单' : '还没有' + tabs[activeTab].value + '的订单'}}</view>
      <view class="empty_btn btn-primary" bindtap="goHome">去逛逛</view>
    </view>
  </view>
</view>
