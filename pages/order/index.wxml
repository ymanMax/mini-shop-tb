<!--pages/order/index.wxml —— 订单列表-->
<view class="order_page">
  <!-- 状态 Tab -->
  <view class="tabs_bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab_item {{activeTab === item.key ? 'active' : ''}}"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{skeleton}}" class="sk_list">
    <view class="sk_card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton sk_line w40"></view>
      <view class="skeleton sk_line w80"></view>
      <view class="skeleton sk_line w60"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view wx:elif="{{orders.length > 0}}" class="order_list">
    <view class="order_card" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <!-- 卡片头：订单号 + 状态 -->
      <view class="card_header">
        <view class="order_no">订单号：{{item.orderNo}}</view>
        <view class="status_badge status-{{item.status}}">{{item.statusText}}</view>
      </view>

      <!-- 商品行 -->
      <view class="goods_rows">
        <view class="goods_row" wx:for="{{item.items}}" wx:for-item="g" wx:key="goodsId">
          <image class="g_img" src="{{g.mainPic}}" mode="aspectFill" binderror="handleImgError" data-path="orders[{{index}}].items[0].mainPic" catchtap="goDetail" data-id="{{item.id}}" />
          <view class="g_info">
            <view class="g_name">{{g.name}}</view>
            <view class="g_spec">{{g.specText}}</view>
          </view>
          <view class="g_right">
            <view class="g_price price">¥{{g.price}}</view>
            <view class="g_count">×{{g.count}}</view>
          </view>
        </view>
        <view wx:if="{{item.items.length > 1}}" class="more_items">共 {{item.itemCount}} 件商品</view>
      </view>

      <!-- 金额 + 时间 -->
      <view class="card_footer">
        <view class="order_time">{{item.createTimeText}}</view>
        <view class="amount">实付：<text class="price big">¥{{item.payAmount}}</text></view>
      </view>

      <!-- 操作按钮 -->
      <view class="card_actions" catchtap="stopPropagation">
        <view class="btn-outline act_btn" bindtap="goDetail" data-id="{{item.id}}">查看详情</view>
        <view wx:if="{{item.status === 1}}" class="btn-outline act_btn" bindtap="cancelOrder" data-orderno="{{item.orderNo}}">取消订单</view>
        <view wx:if="{{item.status === 1}}" class="btn-primary act_btn" bindtap="payOrder" data-orderno="{{item.orderNo}}">去支付</view>
        <view wx:if="{{item.status === 2}}" class="btn-outline act_btn" bindtap="urgeOrder" data-orderno="{{item.orderNo}}">催发货</view>
        <view wx:if="{{item.status === 3}}" class="btn-outline act_btn" bindtap="viewLogistics" data-id="{{item.id}}">查看物流</view>
        <view wx:if="{{item.status === 4}}" class="btn-outline act_btn" bindtap="viewLogistics" data-id="{{item.id}}">查看物流</view>
        <view wx:if="{{item.status === 4}}" class="btn-primary act_btn" bindtap="confirmReceive" data-orderno="{{item.orderNo}}">确认收货</view>
        <view wx:if="{{item.status === 5 && !item.isReviewed}}" class="btn-outline act_btn" bindtap="goReview" data-orderno="{{item.orderNo}}">去评价</view>
        <view wx:if="{{item.status === 5}}" class="btn-outline act_btn" bindtap="againOrder" data-orderno="{{item.orderNo}}">再来一单</view>
        <view wx:if="{{item.status === 6}}" class="act_btn disabled_text">已取消</view>
      </view>
    </view>

    <view wx:if="{{noMore}}" class="no_more">—— 没有更多了 ——</view>
    <view wx:if="{{loading}}" class="loading_tip">加载中…</view>
  </view>

  <!-- 空态 -->
  <view wx:else class="empty-state">
    <view class="empty-icon">📦</view>
    <view class="empty-text">还没有相关订单</view>
    <view class="btn-primary go_shop" bindtap="goShop">去逛逛</view>
  </view>
</view>
