<!--pages/order/index.wxml-->
<view class="page">
  <!-- 状态 Tab：吸顶 -->
  <view class="tabs">
    <view
      class="tab-item {{item.isActive ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="status"
      bindtap="onTabTap"
      data-index="{{index}}"
    >
      <text>{{item.value}}</text>
      <view class="tab-line" wx:if="{{item.isActive}}"></view>
    </view>
  </view>

  <!-- 订单数量概览 -->
  <view class="count-bar" wx:if="{{count.all > 0}}">
    <view class="count-item" bindtap="onTabTap" data-index="0">
      <text class="count-num">{{count.all}}</text>
      <text class="count-label">全部</text>
    </view>
    <view class="count-item" bindtap="onTabTap" data-index="1">
      <text class="count-num">{{count.pay}}</text>
      <text class="count-label">待付款</text>
    </view>
    <view class="count-item" bindtap="onTabTap" data-index="2">
      <text class="count-num">{{count.deliver}}</text>
      <text class="count-label">待发货</text>
    </view>
    <view class="count-item" bindtap="onTabTap" data-index="3">
      <text class="count-num">{{count.receive}}</text>
      <text class="count-label">待收货</text>
    </view>
    <view class="count-item" bindtap="onTabTap" data-index="4">
      <text class="count-num">{{count.done}}</text>
      <text class="count-label">已完成</text>
    </view>
  </view>

  <!-- 首次加载骨架屏：2 条订单卡片 -->
  <view class="skeleton-card" wx:if="{{loading}}" wx:for="{{[1, 2]}}" wx:key="*this">
    <view class="sk-row">
      <view class="skeleton-block sk-line sk-w40"></view>
      <view class="skeleton-block sk-badge"></view>
    </view>
    <view class="sk-body">
      <view class="skeleton-block sk-thumb"></view>
      <view class="sk-info">
        <view class="skeleton-block sk-line"></view>
        <view class="skeleton-block sk-line sk-w60"></view>
        <view class="skeleton-block sk-line sk-w30"></view>
      </view>
    </view>
    <view class="sk-foot">
      <view class="skeleton-block sk-line sk-w30"></view>
      <view class="skeleton-block sk-line sk-w40"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="list" wx:if="{{!loading}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="handleDetail" data-id="{{item.id}}">
      <!-- 顶部：订单号 + 状态徽章 -->
      <view class="card-head">
        <text class="order-no">订单号 {{item.orderNo}}</text>
        <text class="status-badge {{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <!-- 单商品：缩略图 + 详情 -->
      <block wx:if="{{item.items.length === 1}}">
        <view class="goods-row">
          <view class="goods-thumb">
            <image
              src="{{item.mainItem.mainPic}}"
              mode="aspectFill"
              binderror="handleImageError"
              data-oi="{{index}}"
              data-gi="0"
            />
          </view>
          <view class="goods-info">
            <view class="goods-name ellipsis-2">{{item.mainItem.name}}</view>
            <view class="goods-spec ellipsis">{{item.mainItem.specText}}</view>
            <view class="goods-price">
              <text class="price-symbol">¥</text>
              <text class="price">{{item.mainItem.priceText}}</text>
              <text class="goods-count">×{{item.mainItem.count}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 多商品：横向前 3 张缩略图 + 共 n 件 -->
      <block wx:else>
        <view class="thumb-row">
          <block wx:for="{{item.items}}" wx:for-item="g" wx:for-index="gi" wx:key="goodsId">
            <view class="goods-thumb" wx:if="{{gi < 3}}">
              <image
                src="{{g.mainPic}}"
                mode="aspectFill"
                binderror="handleImageError"
                data-oi="{{index}}"
                data-gi="{{gi}}"
              />
            </view>
          </block>
          <view class="thumb-more" wx:if="{{item.items.length > 3}}">+{{item.items.length - 3}}</view>
          <text class="thumb-count">共 {{item.itemCount}} 件</text>
        </view>
      </block>

      <!-- 底部：实付 + 下单时间 -->
      <view class="card-foot">
        <view class="foot-amount">实付 <text class="price price-amount">¥{{item.payAmountText}}</text></view>
        <text class="foot-time">{{item.createTimeText}}</text>
      </view>

      <!-- 状态操作按钮（catchtap 阻止冒泡到整卡跳转） -->
      <view class="card-actions">
        <block wx:if="{{item.status === 1}}">
          <view class="act-btn" catchtap="handleCancel" data-id="{{item.id}}">取消订单</view>
          <view class="act-btn act-primary" catchtap="handlePay" data-id="{{item.id}}">去支付</view>
        </block>
        <block wx:elif="{{item.status === 2}}">
          <view class="act-btn act-primary" catchtap="handleUrge" data-id="{{item.id}}">催发货</view>
        </block>
        <block wx:elif="{{item.status === 3 || item.status === 4}}">
          <view class="act-btn" catchtap="handleViewLogistics" data-id="{{item.id}}">查看物流</view>
          <view class="act-btn act-primary" catchtap="handleConfirm" data-id="{{item.id}}">确认收货</view>
        </block>
        <block wx:elif="{{item.status === 5}}">
          <view class="act-btn act-cancel" catchtap="handleAgain" data-id="{{item.id}}">再来一单</view>
          <view class="act-btn act-primary" wx:if="{{!item.isReviewed}}" catchtap="handleReview" data-id="{{item.id}}">去评价</view>
        </block>
        <view class="act-btn act-disabled" wx:if="{{item.status === 6}}">已取消</view>
        <view class="act-btn" catchtap="handleDetail" data-id="{{item.id}}">查看详情</view>
      </view>
    </view>

    <view class="list-more" wx:if="{{loadingMore}}">加载中...</view>
    <view class="list-end" wx:if="{{!loadingMore && noMore && orders.length > 0}}">没有更多了</view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{!loading && orders.length === 0}}">
    <view class="empty-icon">{{tabs[activeIndex].icon}}</view>
    <view class="empty-text">{{tabs[activeIndex].emptyText}}</view>
    <view class="empty-btn btn-primary" bindtap="goHome">去逛逛</view>
  </view>
</view>
