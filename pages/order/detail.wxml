<!--pages/order/detail.wxml-->
<view class="detail_page" wx:if="{{order}}">
  <!-- 订单状态头部 -->
  <view class="status_header">
    <view class="status_icon">{{statusInfo.icon}}</view>
    <view class="status_text">{{statusInfo.text}}</view>
    <view class="status_desc">{{statusInfo.desc}}</view>
  </view>

  <!-- 物流跟踪 -->
  <view class="section_card" wx:if="{{showTimeline}}" id="logistics_section">
    <view class="section_title"><text>物流跟踪</text></view>
    <view class="logistics_info" wx:if="{{order.logistics.company}}">
      <text class="logistics_company">{{order.logistics.company}}</text>
      <text class="logistics_no">单号：{{order.logistics.trackingNo}}</text>
    </view>
    <view class="timeline">
      <view class="tl_node {{item.done ? 'done' : ''}}" wx:for="{{timeline}}" wx:key="title">
        <view class="tl_dot">{{item.done ? '●' : '○'}}</view>
        <view class="tl_content">
          <view class="tl_title">{{item.title}}</view>
          <view class="tl_desc">{{item.desc}}</view>
          <view class="tl_time" wx:if="{{item.timeText}}">{{item.timeText}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="section_card">
    <view class="section_title"><text>收货地址</text></view>
    <view class="addr_row">
      <text class="addr_name">{{order.addressSnapshot.name}}</text>
      <text class="addr_phone">{{order.addressSnapshot.phone}}</text>
    </view>
    <view class="addr_detail">{{order.addressSnapshot.address}}</view>
  </view>

  <!-- 商品清单 -->
  <view class="section_card">
    <view class="section_title"><text>商品清单</text></view>
    <view class="goods_row" wx:for="{{order.items}}" wx:key="goodsId">
      <image class="goods_img" src="{{item.mainPic}}" mode="aspectFill" binderror="onImgError" data-index="{{index}}" />
      <view class="goods_info">
        <view class="goods_name ellipsis-2">{{item.name}}</view>
        <view class="goods_spec">{{item.specText}}</view>
        <view class="goods_bottom">
          <text class="goods_price">{{item.priceText}}</text>
          <text class="goods_count">×{{item.count}}</text>
          <text class="goods_subtotal">{{item.subtotalText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 金额明细 -->
  <view class="section_card">
    <view class="section_title"><text>金额明细</text></view>
    <view class="amount_row">
      <text>商品总价</text>
      <text>{{totalAmountText}}</text>
    </view>
    <view class="amount_row">
      <text>优惠金额</text>
      <text class="discount">-{{discountText}}</text>
    </view>
    <view class="amount_row">
      <text>运费</text>
      <text>{{freightText}}</text>
    </view>
    <view class="amount_row total">
      <text>实付金额</text>
      <text class="pay_amount">{{payAmountText}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="section_card">
    <view class="section_title"><text>订单信息</text></view>
    <view class="info_row" bindtap="copyOrderNo">
      <text class="info_label">订单号</text>
      <text class="info_value">{{order.orderNo}} <text class="copy_link">复制</text></text>
    </view>
    <view class="info_row">
      <text class="info_label">下单时间</text>
      <text class="info_value">{{createTimeText}}</text>
    </view>
    <view class="info_row">
      <text class="info_label">支付方式</text>
      <text class="info_value">微信支付</text>
    </view>
    <view class="info_row">
      <text class="info_label">备注</text>
      <text class="info_value">无</text>
    </view>
  </view>

  <!-- 模拟配送进度（演示用） -->
  <view class="section_card simulate_card">
    <view class="section_title"><text>模拟配送进度（演示）</text></view>
    <view class="simulate_btns">
      <view class="sim_btn" wx:if="{{order.status === 2}}" bindtap="simulateShip">模拟发货</view>
      <view class="sim_btn" wx:if="{{order.status === 3}}" bindtap="simulateDeliver">模拟配送</view>
      <view class="sim_btn" wx:if="{{order.status === 4}}" bindtap="simulateReach">模拟送达</view>
      <view class="sim_tip" wx:if="{{order.status === 5 || order.status === 6}}">订单已完结</view>
      <view class="sim_tip" wx:if="{{order.status === 1}}">请先完成支付</view>
    </view>
  </view>

  <view class="bottom_placeholder"></view>
</view>

<!-- 底部操作栏 -->
<view class="bottom_bar" wx:if="{{order}}">
  <!-- 待付款 -->
  <block wx:if="{{order.status === 1}}">
    <view class="bar_btn outline" bindtap="cancelOrder">取消订单</view>
    <view class="bar_btn primary" bindtap="goPay">去支付</view>
  </block>
  <!-- 待发货 -->
  <block wx:if="{{order.status === 2}}">
    <view class="bar_btn outline" bindtap="urgeOrder">催发货</view>
  </block>
  <!-- 配送中/待收货 -->
  <block wx:if="{{order.status === 3 || order.status === 4}}">
    <view class="bar_btn outline" bindtap="viewLogistics">查看物流</view>
    <view class="bar_btn primary" bindtap="confirmReceive">确认收货</view>
  </block>
  <!-- 已完成 -->
  <block wx:if="{{order.status === 5}}">
    <view class="bar_btn outline" wx:if="{{!order.isReviewed}}" bindtap="goReview">去评价</view>
    <view class="bar_btn primary" bindtap="reorder">再来一单</view>
  </block>
</view>
