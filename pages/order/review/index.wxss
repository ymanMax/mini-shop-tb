/* pages/order/review/index.wxss */
page { background: #f5f5f5; padding-bottom: 140rpx; }
.review_page { padding-bottom: 140rpx; }
.tip_bar {
  background: var(--themeLight);
  color: var(--themeColor);
  font-size: 24rpx;
  padding: 20rpx 24rpx;
  text-align: center;
}
.form_card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}
.goods_row {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.g_img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.g_info { flex: 1; }
.g_name {
  font-size: 27rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 38rpx;
}
.g_spec { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.g_price { font-size: 28rpx; font-weight: 600; }

.rating_row, .tags_row, .content_row, .upload_row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.rating_label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.stars.big .star { font-size: 56rpx; margin-right: 12rpx; }
.rating_text { font-size: 26rpx; color: #ffb400; margin-left: 16rpx; }

.tag_list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.quick_tag {
  padding: 8rpx 24rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
}
.quick_tag.active {
  background: var(--themeLight);
  color: var(--themeColor);
  border: 1rpx solid var(--themeColor);
}

.content_input {
  width: 100%;
  height: 160rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.char_count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.img_list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.upload_img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
}
.upload_add {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}
.upload_add .plus { font-size: 48rpx; line-height: 1; }
.upload_add .add_text { font-size: 22rpx; margin-top: 8rpx; }

.submit_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.submit_btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}
