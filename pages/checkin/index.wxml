<!--pages/checkin/index.wxml-->
<view class="checkin_page">
  <!-- 头部 -->
  <view class="header_card">
    <view class="consecutive">
      <view class="consecutive_num">{{consecutiveDays}}</view>
      <view class="consecutive_label">连续签到（天）</view>
    </view>
    <view class="sign_btn {{signed ? 'signed' : ''}}" bindtap="sign">
      {{signed ? '今日已签到 ✓' : '立即签到 +5'}}
    </view>
  </view>

  <!-- 连签奖励条 -->
  <view class="reward_card">
    <view class="card_title">连续签到奖励</view>
    <view class="reward_row">
      <view class="reward_item" wx:for="{{rewards}}" wx:key="day">
        <view class="reward_day">第{{item.day}}天</view>
        <view class="reward_points">+{{item.points}}</view>
      </view>
    </view>
    <view class="rule_tip">断签后重新从第 1 天计算，第 7 天大奖 +50 积分</view>
  </view>

  <!-- 日历 -->
  <view class="calendar_card">
    <view class="calendar_header">
      <view class="month_nav" bindtap="prevMonth">‹</view>
      <view class="month_title">{{year}}年{{month + 1}}月</view>
      <view class="month_nav" bindtap="nextMonth">›</view>
    </view>
    <view class="week_row">
      <view class="week_cell" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="day_grid">
      <view
        class="day_cell {{item.signed ? 'signed' : ''}} {{item.isToday ? 'today' : ''}} {{item.isFuture ? 'future' : ''}}"
        wx:for="{{days}}"
        wx:key="day"
      >
        <view class="day_num" wx:if="{{!item.empty}}">{{item.day}}</view>
        <view class="day_mark" wx:if="{{item.signed && !item.empty}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 签到成功弹层 -->
  <view class="mask" wx:if="{{showSuccess}}" bindtap="closeSuccess"></view>
  <view class="success_panel {{showSuccess ? 'show' : ''}}">
    <view class="success_icon">🎉</view>
    <view class="success_title">签到成功</view>
    <view class="success_reward">+{{reward}} 积分</view>
    <view class="success_btn" bindtap="closeSuccess">开心收下</view>
  </view>
</view>
