/* pages/goods_list/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}
.goods_grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}
.goods_card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.goods_img {
  width: 100%;
  height: 280rpx;
  display: block;
}
.goods_info { padding: 16rpx; }
.goods_name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  height: 72rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.goods_bottom {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.price { color: #eb4450; font-size: 32rpx; font-weight: bold; }
.origin { color: #999; font-size: 22rpx; text-decoration: line-through; margin-left: 8rpx; }
.sales { color: #999; font-size: 20rpx; margin-top: 4rpx; }
.add_cart {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background: #eb4450;
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}
.skeleton { padding: 20rpx; }
.sk_card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: inline-block;
  vertical-align: top;
}
.sk_img { width: 100%; height: 280rpx; background: #eee; border-radius: 12rpx; }
.sk_line { height: 24rpx; background: #eee; border-radius: 8rpx; margin-top: 16rpx; }
.w80 { width: 80%; }
.w60 { width: 60%; }
.breath { animation: breath 1.2s infinite ease-in-out; }
@keyframes breath {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
.empty_state { text-align: center; padding: 120rpx 0; }
.empty_icon { font-size: 100rpx; }
.empty_text { color: #999; margin: 20rpx 0; font-size: 28rpx; }
.no_more { text-align: center; color: #bbb; font-size: 24rpx; padding: 30rpx 0; }
