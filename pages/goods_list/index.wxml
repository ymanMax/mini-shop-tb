<!--pages/goods_list/index.wxml-->
<view class="list_page">
  <!-- 搜索栏 -->
  <view class="search_bar" bindtap="goSearch">
    <view class="search_inner">
      <text class="search_icon">🔍</text>
      <text class="search_placeholder">{{keyword || '搜索商品'}}</text>
    </view>
  </view>

  <!-- 排序栏 -->
  <view class="sort_bar">
    <view
      class="sort_item {{activeTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="id"
      bindtap="onTabTap"
      data-index="{{index}}"
    >{{item.value}}</view>
  </view>

  <!-- 骨架屏 -->
  <view class="skeleton_list" wx:if="{{skeleton}}">
    <view class="skeleton_row" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="skeleton skeleton_img"></view>
      <view class="skeleton_col">
        <view class="skeleton skeleton_line w80"></view>
        <view class="skeleton skeleton_line w60"></view>
        <view class="skeleton skeleton_line w40"></view>
      </view>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="goods_list" wx:else>
    <view class="goods_item" wx:for="{{goodsList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="goods_img" src="{{item.mainPic}}" mode="aspectFill" binderror="onImgError" data-index="{{index}}" />
      <view class="goods_info">
        <view class="goods_name ellipsis-2">{{item.name}}</view>
        <view class="goods_bottom">
          <text class="goods_price">{{item.priceText}}</text>
          <text class="original_price" wx:if="{{item.originalPrice > item.price}}">{{item.originalPriceText}}</text>
        </view>
        <view class="sales">已售{{item.sales}}件</view>
      </view>
      <view class="add_btn" catchtap="addToCart" data-item="{{item}}">＋</view>
    </view>

    <view class="no_more" wx:if="{{noMore && goodsList.length > 0}}">—— 没有更多了 ——</view>
    <view class="empty-wrap" wx:if="{{goodsList.length === 0}}">
      <view class="empty-icon">🫓</view>
      <view class="empty-text">暂无商品</view>
    </view>
  </view>
</view>
