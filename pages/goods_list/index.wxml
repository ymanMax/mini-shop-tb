<!--pages/goods_list/index.wxml-->
<view class="page">
  <Tabs tabs="{{tabs}}" bind:tabsItenChange="handleTabChange" />

  <view class="goods_grid" wx:if="{{!loading && goodsList.length}}">
    <view class="goods_card" wx:for="{{goodsList}}" wx:key="id">
      <image
        class="goods_img"
        src="{{item.mainPic}}"
        mode="aspectFill"
        data-index="{{index}}"
        binderror="handleImgError"
        bindtap="goDetail"
        data-id="{{item.id}}"
      />
      <view class="goods_info">
        <view class="goods_name" bindtap="goDetail" data-id="{{item.id}}">{{item.name}}</view>
        <view class="goods_bottom">
          <text class="price">{{item.priceText}}</text>
          <text class="origin">{{item.originPriceText}}</text>
        </view>
        <view class="sales">已售{{item.sales}}件</view>
      </view>
      <view class="add_cart" catchtap="handleAddCart" data-goods="{{item}}">＋</view>
    </view>
  </view>

  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk_card breath" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="sk_img"></view>
      <view class="sk_line w80"></view>
      <view class="sk_line w60"></view>
    </view>
  </view>

  <view class="empty_state" wx:if="{{!loading && !goodsList.length}}">
    <view class="empty_icon">🔍</view>
    <view class="empty_text">没有找到相关商品</view>
  </view>

  <view class="no_more" wx:if="{{noMore && !loading}}">—— 没有更多了 ——</view>
</view>
