/* pages/auth/index.wxss */
page {
  background: var(--bgPage);
}

.auth_page {
  padding: 0 32rpx 60rpx;
}

/* ==================== 头部 ==================== */
.auth_header {
  padding: 80rpx 0 56rpx;
  text-align: center;
}

.auth_icon {
  font-size: 110rpx;
  line-height: 1.1;
}

.auth_title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--textMain);
  margin-top: 24rpx;
}

.auth_sub {
  font-size: 25rpx;
  color: var(--textLight);
  margin-top: 14rpx;
}

/* ==================== 授权项 ==================== */
.scope_list {
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 32rpx;
}

.scope_item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--borderColor);
}

.scope_item:last-child {
  border-bottom: none;
}

.scope_icon {
  font-size: 42rpx;
  margin-right: 24rpx;
}

.scope_text {
  flex: 1;
  min-width: 0;
}

.scope_name {
  font-size: 28rpx;
  color: var(--textMain);
  font-weight: 500;
}

.scope_required {
  font-size: 20rpx;
  color: var(--themeColor);
  background: var(--themeColorFade);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}

.scope_desc {
  font-size: 23rpx;
  color: var(--textLight);
  margin-top: 6rpx;
}

.scope_check {
  font-size: 32rpx;
  flex-shrink: 0;
}

/* ==================== 当前账号 ==================== */
.account_card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-top: 24rpx;
}

.account_avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.account_info {
  margin-left: 24rpx;
  min-width: 0;
}

.account_name {
  font-size: 30rpx;
  color: var(--textMain);
  font-weight: 500;
}

.account_phone {
  font-size: 24rpx;
  color: var(--textLight);
  margin-top: 8rpx;
}

/* ==================== 说明与操作 ==================== */
.notice {
  font-size: 23rpx;
  color: #b06a10;
  background: #fff8e8;
  border-radius: 12rpx;
  padding: 22rpx 26rpx;
  line-height: 36rpx;
  margin-top: 24rpx;
}

.actions {
  margin-top: 56rpx;
}

.auth_btn {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(90deg, #ff6b76, #eb4450);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.auth_btn::after {
  border: none;
}

.back_btn {
  text-align: center;
  font-size: 27rpx;
  color: var(--textSub);
  padding: 32rpx 0;
}
