<!-- pages/address/list.wxml -->
<view class="page">

  <!-- 首屏骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="skeleton-block skeleton-line" style="width: 34%;"></view>
      <view class="skeleton-block skeleton-line" style="width: 88%;"></view>
      <view class="skeleton-block skeleton-line" style="width: 60%;"></view>
    </view>
  </view>

  <block wx:if="{{!loading}}">

    <!-- 空态 -->
    <view wx:if="{{list.length === 0}}" class="empty">
      <view class="empty-icon">📭</view>
      <view class="empty-text">还没有收货地址，点击下方按钮新增~</view>
    </view>

    <!-- 地址列表 -->
    <view wx:else class="addr-list">
      <view class="addr-item" wx:for="{{list}}" wx:key="id">
        <!-- 左滑露出的删除按钮（仅管理模式展示） -->
        <view
          wx:if="{{mode === 'manage'}}"
          class="addr-item__delete"
          catchtap="handleDelete"
          data-id="{{item.id}}"
        >删除</view>

        <!-- 内容层：touch 事件做左滑位移 -->
        <view
          class="addr-item__content {{mode === 'select' && currentId === item.id ? 'is-current' : ''}}"
          style="transform: translateX({{slideId === item.id ? slideX : 0}}rpx);"
          data-id="{{item.id}}"
          bindtouchstart="handleTouchStart"
          bindtouchmove="handleTouchMove"
          bindtouchend="handleTouchEnd"
          catchtap="handleCardTap"
        >
          <view class="addr-item__top {{item.isDefault ? 'has-default' : ''}}">
            <text class="addr-item__name">{{item.userName}}</text>
            <text class="addr-item__phone">{{item.telNumber}}</text>
            <text class="tag-pill {{item.tagClass}}">{{item.tag}}</text>
          </view>

          <view class="addr-item__detail">{{item.all}}</view>

          <view class="addr-item__bottom">
            <view wx:if="{{item.isDefault}}" class="addr-item__default-check">✓ 默认地址</view>
            <view wx:else class="addr-item__bottom-space"></view>

            <!-- 管理模式操作区：选择模式下隐藏，避免误操作 -->
            <view wx:if="{{mode === 'manage'}}" class="addr-item__actions">
              <view class="addr-action" catchtap="handleEdit" data-id="{{item.id}}">✏️ 编辑</view>
              <view
                wx:if="{{!item.isDefault}}"
                class="addr-action addr-action--primary"
                catchtap="handleSetDefault"
                data-id="{{item.id}}"
              >设为默认</view>
            </view>
          </view>

          <!-- 默认标签：卡片右上角绿色系 -->
          <view wx:if="{{item.isDefault}}" class="addr-item__default-tag">默认</view>
        </view>
      </view>
    </view>
  </block>

  <view class="addr-list-placeholder"></view>
</view>

<!-- 底部固定新增按钮 -->
<view class="addr-footer safe-area-bottom">
  <view
    class="btn-primary addr-footer__btn {{isFull ? 'is-disabled' : ''}}"
    catchtap="handleAdd"
  >+ 新增地址</view>
</view>
