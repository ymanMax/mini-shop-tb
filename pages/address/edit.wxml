<!--pages/address/edit.wxml-->
<view class="edit_page">
  <view class="form_card">
    <!-- 收货人 -->
    <view class="form_row">
      <text class="form_label">收货人</text>
      <input placeholder="请输入姓名" value="{{name}}" bindinput="onNameInput" />
    </view>
    <!-- 手机号 -->
    <view class="form_row">
      <text class="form_label">手机号</text>
      <input type="number" maxlength="11" placeholder="请输入11位手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <!-- 所在地区 -->
    <view class="form_row">
      <text class="form_label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="region_picker">
          <text wx:if="{{region.length === 3}}">{{region[0]}} {{region[1]}} {{region[2]}}</text>
          <text wx:else class="placeholder">请选择省/市/区</text>
          <text class="picker_arrow">›</text>
        </view>
      </picker>
    </view>
    <!-- 详细地址 -->
    <view class="form_row column">
      <text class="form_label">详细地址</text>
      <textarea placeholder="街道、门牌号、小区等" value="{{detail}}" bindinput="onDetailInput" class="detail_input" />
    </view>
  </view>

  <!-- 地址标签 -->
  <view class="form_card">
    <view class="form_label">地址标签</view>
    <view class="tag_list">
      <view
        class="tag_option {{tag === item ? 'active' : ''}}"
        wx:for="{{tagOptions}}"
        wx:key="*this"
        bindtap="onTagTap"
        data-tag="{{item}}"
      >{{item}}</view>
    </view>
  </view>

  <!-- 设为默认 -->
  <view class="form_card">
    <view class="default_row">
      <text class="form_label">设为默认地址</text>
      <switch checked="{{isDefault}}" bindchange="onDefaultChange" color="#eb4450" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save_bar">
    <view class="save_btn" bindtap="save">保存</view>
  </view>
</view>
