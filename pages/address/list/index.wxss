/* pages/address/list/index.wxss */
page { background: #f5f5f5; }
.addr_list_page { padding-bottom: 140rpx; }

.addr_cards { padding: 20rpx; }
.addr_card {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.delete_btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: var(--themeColor);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.card_main {
  padding: 24rpx;
  background: #fff;
  position: relative;
  z-index: 1;
  transition: transform 0.2s;
}
.addr_card.swiped .card_main {
  transform: translateX(-140rpx);
}
.card_top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.a_name { font-size: 30rpx; font-weight: 600; }
.a_phone { font-size: 26rpx; color: #666; }
.a_tag {
  font-size: 20rpx;
  color: var(--themeColor);
  background: var(--themeLight);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.default_badge {
  font-size: 20rpx;
  color: #fff;
  background: var(--green, #52c41a);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-left: auto;
}
.a_region {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  line-height: 40rpx;
}
.card_actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}
.act_btn {
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 999rpx;
}

.empty-state .empty-icon { font-size: 100rpx; }

.bottom_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.add_btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(90deg, #ff5b6a, #eb4450);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
}
