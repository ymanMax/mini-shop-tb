/* pages/address/edit.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}
.form_card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.form_row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form_row.column {
  flex-direction: column;
  align-items: flex-start;
}
.form_label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}
.form_input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.picker_text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.picker_text.placeholder { color: #999; }
.form_textarea {
  width: 100%;
  min-height: 120rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  font-size: 28rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.tag_list {
  display: flex;
  flex-wrap: wrap;
}
.tag_item {
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
  border: 2rpx solid transparent;
}
.tag_item.active {
  background: #fdf0f1;
  color: #eb4450;
  border-color: #eb4450;
}
.bottom_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
.save_btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #eb4450;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
