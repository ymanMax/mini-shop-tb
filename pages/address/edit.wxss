/* pages/address/edit.wxss */
page {
  background: #f5f5f5;
}
.edit_page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.form_card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.form_row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form_row.column {
  flex-direction: column;
  align-items: stretch;
}
.form_row:last-child {
  border-bottom: none;
}
.form_label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}
.form_row input {
  flex: 1;
  font-size: 28rpx;
}
.region_picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
}
.region_picker .placeholder {
  color: #999;
}
.picker_arrow {
  color: #ccc;
  font-size: 32rpx;
}
.detail_input {
  width: 100%;
  height: 160rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}

/* 标签 */
.tag_list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.tag_option {
  padding: 12rpx 32rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #f2f2f2;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid transparent;
}
.tag_option.active {
  background: #fff5f6;
  color: #eb4450;
  border-color: #eb4450;
}

/* 默认开关 */
.default_row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 保存按钮 */
.save_bar {
  margin-top: 40rpx;
}
.save_btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(90deg, #ff5a66, #eb4450);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}
