<!--pages/message/index.wxml-->
<view class="page">
  <view class="top_bar">
    <view class="read_all_btn" bindtap="readAll">全部已读</view>
  </view>

  <Tabs tabs="{{tabs}}" bind:tabsItenChange="handleTabChange" />

  <view class="message_list" wx:if="{{!loading && messages.length}}">
    <view
      class="message_card {{!item.isRead ? 'unread' : ''}}"
      wx:for="{{messages}}"
      wx:key="id"
      bindtap="handleMessageTap"
      data-id="{{item.id}}"
      data-type="{{item.type}}"
      data-related-id="{{item.relatedId}}"
    >
      <view class="msg_icon">
        <text wx:if="{{item.type === 1}}">⚙️</text>
        <text wx:elif="{{item.type === 2}}">📦</text>
        <text wx:else>🎉</text>
      </view>
      <view class="msg_info">
        <view class="msg_head">
          <text class="msg_title">{{item.title}}</text>
          <text class="msg_time">{{item.timeText}}</text>
        </view>
        <view class="msg_content">{{item.content}}</view>
      </view>
      <view class="unread_dot" wx:if="{{!item.isRead}}"></view>
    </view>
  </view>

  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk_card breath" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk_line w90"></view>
      <view class="sk_line w60"></view>
    </view>
  </view>

  <view class="empty_state" wx:if="{{!loading && !messages.length}}">
    <view class="empty_icon">📭</view>
    <view class="empty_text">暂无消息</view>
  </view>
</view>
