/* pages/message/index.wxss */
page {
  background: #f5f5f5;
}
.message_page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.top_bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background: #fff;
}
.read_all {
  font-size: 26rpx;
  color: #eb4450;
}

.tab_bar {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab_item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #555;
  position: relative;
}
.tab_item.active {
  color: #eb4450;
  font-weight: bold;
}
.tab_item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #eb4450;
  border-radius: 3rpx;
}

.message_list {
  padding: 24rpx;
}
.message_item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.msg_icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}
.msg_info {
  flex: 1;
}
.msg_title_row {
  display: flex;
  align-items: center;
}
.msg_title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}
.msg_unread {
  width: 16rpx;
  height: 16rpx;
  background: #eb4450;
  border-radius: 50%;
  margin-left: 12rpx;
}
.msg_content {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 1.5;
}
.msg_time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
