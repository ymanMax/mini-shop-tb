/* pages/message/index.wxss */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ============ 吸顶区：未读概览 + 全部已读 + Tab ============ */
.sticky-head {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.head-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx 0;
}

.unread-tip {
  font-size: 24rpx;
  color: var(--textSub);
}

.read-all {
  font-size: 24rpx;
  color: var(--themeColor);
  line-height: 52rpx;
  height: 52rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(235, 68, 80, 0.4);
  border-radius: 999rpx;
}

.read-all.disabled {
  color: #cccccc;
  border-color: #eeeeee;
}

.tabs {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.tab-item {
  position: relative;
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--textSub);
}

.tab-item.on {
  color: var(--themeColor);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  width: 44rpx;
  height: 6rpx;
  margin-left: -22rpx;
  border-radius: 6rpx;
  background: var(--themeColor);
}

/* ============ 消息列表 ============ */
.list {
  padding: 16rpx 20rpx 0;
}

.msg-card {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 类型图标：淡色圆形底 */
.type-icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 50%;
}

.type-system {
  background: rgba(47, 124, 246, 0.12);
}

.type-order {
  background: rgba(255, 149, 0, 0.14);
}

.type-promo {
  background: rgba(235, 68, 80, 0.1);
}

.msg-body {
  min-width: 0;
}

.msg-top {
  display: flex;
  align-items: center;
}

.title-wrap {
  display: flex;
  align-items: center;
  min-width: 0;
}

.dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--themeColor);
}

.msg-title {
  min-width: 0;
  font-size: 30rpx;
  color: var(--textMain);
  font-weight: 600;
  line-height: 42rpx;
}

.msg-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--textLight);
}

.content-wrap {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
}

.msg-content {
  flex: 1;
  min-width: 0;
  display: block;
  font-size: 24rpx;
  color: var(--textSub);
  line-height: 36rpx;
}

/* 展开态覆盖全局 ellipsis 的单行截断 */
.msg-content.expanded {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  display: block;
}

.expand-hint {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--themeColor);
}

/* 已读消息整体降饱和 */
.msg-card.read .type-icon {
  opacity: 0.5;
}

.msg-card.read .msg-title {
  color: var(--textLight);
  font-weight: 400;
}

.msg-card.read .msg-content {
  color: #b3b3b3;
}

/* 模拟推送新消息的淡入动画 */
.fade-in {
  animation: msg-fade-in 0.5s ease;
}

@keyframes msg-fade-in {
  from {
    opacity: 0;
    transform: translateY(-16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ============ 骨架屏 ============ */
.skeleton-card {
  display: flex;
  align-items: flex-start;
  margin: 16rpx 20rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.sk-icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.sk-main {
  flex: 1;
  margin-left: 20rpx;
}

.sk-line {
  height: 28rpx;
  margin-bottom: 18rpx;
}

.sk-w60 {
  width: 60%;
}

.sk-w90 {
  width: 90%;
}
