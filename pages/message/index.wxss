/* pages/message/index.wxss */
page { background: #f5f5f5; }
.message_page { padding-bottom: 40rpx; }

.msg_top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.msg_title { font-size: 32rpx; font-weight: 700; }
.read_all { font-size: 26rpx; color: var(--themeColor); }

.msg_tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.msg_tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #555;
}
.msg_tab.active {
  color: var(--themeColor);
  font-weight: 600;
  border-bottom: 4rpx solid var(--themeColor);
}

.msg_list { padding: 20rpx; }
.msg_item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.msg_icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  width: 60rpx;
  text-align: center;
}
.msg_body { flex: 1; }
.msg_head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.msg_title_text {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
}
.unread_dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--themeColor);
}
.msg_summary {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
  line-height: 38rpx;
}
.msg_summary.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.msg_item.expanded .msg_summary {
  white-space: normal;
}
.msg_time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.empty-state .empty-icon { font-size: 100rpx; }
