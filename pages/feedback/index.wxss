/* pages/feedback/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}
.feedback_card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.content_input {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  font-size: 26rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.word_count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.upload_list {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 0;
}
.upload_item {
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.upload_item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.remove_btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
}
.upload_add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.add_icon { font-size: 48rpx; color: #999; }
.add_text { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.submit_btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #eb4450;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  margin-top: 24rpx;
}
