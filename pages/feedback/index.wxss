/* pages/feedback/index.wxss */
page {
  background: #f5f5f5;
}
.fb_page {
  padding: 24rpx;
}
.fb_type_section,
.fb_content_section,
.fb_upload_section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.fb_title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.fb_types {
  display: flex;
  flex-wrap: wrap;
}
.fb_type {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #f2f2f2;
  font-size: 26rpx;
  color: #333;
}
.fb_type.active {
  background: #eb4450;
  color: #fff;
}
.fb_textarea {
  width: 100%;
  height: 200rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.word_count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.fb_upload_list {
  display: flex;
  flex-wrap: wrap;
}
.fb_upload_item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}
.fb_upload_img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.fb_upload_remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
}
.fb_upload_add {
  width: 160rpx;
  height: 160rpx;
  border: 1rpx dashed #ccc;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.add_icon {
  font-size: 48rpx;
  color: #ccc;
}
.add_text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.fb_submit {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(90deg, #ff5a66, #eb4450);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}
