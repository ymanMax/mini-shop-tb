/* pages/feedback/index.wxss */
page { background: #f5f5f5; }
.fb_page { padding: 20rpx; }
.type_row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.type_item {
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
}
.type_item.active {
  background: var(--themeColor);
  color: #fff;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.fb_input {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
}
.char_count { text-align: right; font-size: 22rpx; color: #999; }
.section_title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.img_list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.fb_img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
}
.upload_add {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}
.upload_add .plus { font-size: 48rpx; }
.submit_btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}
