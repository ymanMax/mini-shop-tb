<!--pages/feedback/index.wxml-->
<view class="page">
  <Tabs tabs="{{tabs}}" bind:tabsItenChange="handleTabsItemChange" />

  <view class="feedback_card">
    <textarea
      class="content_input"
      placeholder="请描述您遇到的问题或建议，我们会尽快处理~"
      maxlength="500"
      value="{{textVal}}"
      bindinput="handleTextInput"
    />
    <view class="word_count">{{textVal.length}}/500</view>

    <view class="upload_list">
      <view class="upload_item" wx:for="{{chooseImgs}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" binderror="handleImgError" data-field="chooseImgs[{{index}}]" />
        <view class="remove_btn" bindtap="handleRemoveImg" data-index="{{index}}">✕</view>
      </view>
      <view class="upload_add" bindtap="handleChooseImg" wx:if="{{chooseImgs.length < 9}}">
        <text class="add_icon">＋</text>
        <text class="add_text">上传图片</text>
      </view>
    </view>

    <view class="submit_btn" bindtap="handleFormSubmit">提交反馈</view>
  </view>
</view>
