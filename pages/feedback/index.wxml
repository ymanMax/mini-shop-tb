<!--pages/feedback/index.wxml —— 意见反馈-->
<view class="fb_page">
  <view class="type_row">
    <view
      wx:for="{{types}}"
      wx:key="*this"
      class="type_item {{type === item ? 'active' : ''}}"
      bindtap="switchType"
      data-type="{{item}}"
    >{{item}}</view>
  </view>

  <view class="card">
    <textarea
      placeholder="请描述您的问题或建议（100字以内）"
      value="{{textVal}}"
      bindinput="handleTextInput"
      maxlength="100"
      class="fb_input"
    />
    <view class="char_count">{{textVal.length}}/100</view>
  </view>

  <view class="card">
    <view class="section_title">上传图片（最多3张）</view>
    <view class="img_list">
      <image wx:for="{{chooseImgs}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="fb_img" bindtap="removeImg" data-index="{{index}}" />
      <view wx:if="{{chooseImgs.length < 3}}" class="upload_add" bindtap="handleChooseImg">
        <text class="plus">＋</text>
      </view>
    </view>
  </view>

  <view class="submit_btn btn-primary" bindtap="handleSubmit">提交反馈</view>
</view>
