/* pages/search/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
}
.search_bar {
  padding: 16rpx 24rpx;
  background: #fff;
}
.search_inner {
  display: flex;
  align-items: center;
  background: #f2f2f2;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
}
.search_icon { margin-right: 12rpx; font-size: 28rpx; }
.search_input { flex: 1; font-size: 26rpx; }
.cancel_btn { font-size: 26rpx; color: #eb4450; margin-left: 16rpx; }

/* 联想 */
.suggest_panel {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.suggest_item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.suggest_icon { font-size: 24rpx; margin-right: 16rpx; }
.suggest_text { font-size: 26rpx; color: #333; }
.highlight { color: #eb4450; font-weight: bold; }

/* 历史 + 热门 */
.history_section { padding: 24rpx; }
.section_head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section_title { font-size: 28rpx; font-weight: bold; color: #333; }
.clear_history { font-size: 24rpx; color: #999; }
.history_tags { display: flex; flex-wrap: wrap; margin-bottom: 32rpx; }
.history_tag {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #666;
  background: #fff;
  border-radius: 30rpx;
}
.tag_close {
  margin-left: 12rpx;
  color: #bbb;
  font-size: 20rpx;
}
.hot_tags { display: flex; flex-wrap: wrap; }
.hot_tag {
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #ff6b35;
  background: #fff3ee;
  border-radius: 30rpx;
}

/* 结果 */
.goods_list { padding: 0 24rpx; }
.goods_row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.goods_img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.goods_info { flex: 1; }
.goods_name {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.goods_bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}
.price { color: #eb4450; font-size: 30rpx; font-weight: bold; }
.sales { color: #999; font-size: 22rpx; }
.add_cart {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background: #eb4450;
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}
.empty_state { text-align: center; padding: 120rpx 0; }
.empty_icon { font-size: 100rpx; }
.empty_text { color: #999; margin: 20rpx 0; font-size: 28rpx; }
.loading { text-align: center; color: #999; padding: 40rpx; font-size: 26rpx; }
.sort_bar {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}
.sort_item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #333;
}
.sort_item.active { color: #eb4450; font-weight: bold; }
.no_more {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 30rpx 0;
}
