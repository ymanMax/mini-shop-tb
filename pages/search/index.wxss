/* pages/search/index.wxss */
page { background: #f5f5f5; }
.search_page { padding-bottom: 40rpx; }

.search_bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--themeColor);
  gap: 16rpx;
}
.search_box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  height: 64rpx;
  padding: 0 24rpx;
}
.search_icon { font-size: 26rpx; margin-right: 12rpx; }
.search_input { flex: 1; font-size: 26rpx; }
.clear_btn { color: #999; font-size: 28rpx; }
.search_btn {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 历史 / 热门 / 联想 */
.history_section, .hot_section, .suggest_section {
  background: #fff;
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.section_head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section_head .section_title { margin-bottom: 0; }
.clear_history { font-size: 24rpx; color: #999; }
.section_title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }

.history_words { display: flex; flex-wrap: wrap; gap: 16rpx; }
.history_word {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
}
.h_delete {
  margin-left: 10rpx;
  color: #bbb;
  font-size: 22rpx;
}

.hot_words { display: flex; flex-wrap: wrap; gap: 16rpx; }
.hot_word {
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
}

.suggest_item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.suggest_item:last-child { border-bottom: none; }
.sug_img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}
.sug_name {
  flex: 1;
  font-size: 28rpx;
}
.sug_name .hl {
  color: var(--themeColor);
  font-weight: 600;
}
.sug_price { font-size: 26rpx; font-weight: 600; }

/* 排序栏 */
.sort_bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}
.sort_item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #555;
}
.sort_item.active {
  color: var(--themeColor);
  font-weight: 600;
  border-bottom: 4rpx solid var(--themeColor);
}

/* 结果列表 */
.result_list { padding: 20rpx; }
.result_item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.r_img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.r_info { flex: 1; }
.r_name {
  font-size: 28rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 40rpx;
}
.r_tags { margin: 8rpx 0; min-height: 32rpx; }
.r_bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.r_price_row { display: flex; align-items: baseline; }
.r_sales { font-size: 22rpx; color: #999; }
.add_btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--themeColor);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.no_more { text-align: center; color: #999; font-size: 24rpx; padding: 30rpx 0; }
.empty-state .empty-icon { font-size: 100rpx; }
.empty_hint { font-size: 24rpx; color: #999; }
.loading_tip { text-align: center; padding: 60rpx; color: #999; }
