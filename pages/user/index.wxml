<!--pages/user/index.wxml —— 个人中心-->
<view class="user_page">
  <!-- 顶部用户区 -->
  <view class="user_header">
    <view class="user_row">
      <image class="avatar" src="{{userinfo.avatar}}" mode="aspectFill" binderror="handleImgError" data-key="userinfo.avatar" />
      <view class="user_info">
        <view class="nickname">{{userinfo.nickName}}</view>
        <view class="user_meta">
          <text class="level">{{userinfo.level}}</text>
          <text class="phone">{{userinfo.phone}}</text>
        </view>
      </view>
      <view class="points_box">
        <view class="points">{{userinfo.points}}</view>
        <view class="points_label">积分</view>
      </view>
    </view>
    <view class="stats_row">
      <view class="stat" bindtap="goCollect">
        <view class="stat_num">{{collectNums}}</view>
        <view class="stat_label">收藏</view>
      </view>
      <view class="stat">
        <view class="stat_num">{{userinfo.coupons}}</view>
        <view class="stat_label">优惠券</view>
      </view>
      <view class="stat">
        <view class="stat_num">¥{{userinfo.balance}}</view>
        <view class="stat_label">余额</view>
      </view>
      <view class="stat">
        <view class="stat_num">{{userinfo.points}}</view>
        <view class="stat_label">积分</view>
      </view>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="card order_card">
    <view class="card_title">
      <text>我的订单</text>
      <text class="all_orders" bindtap="goOrders" data-type="1">全部订单 ›</text>
    </view>
    <view class="order_grid">
      <view class="order_item" bindtap="goOrders" data-type="2">
        <view class="o_icon">💳</view>
        <view class="o_label">待付款</view>
        <view wx:if="{{orderCounts.unpaid > 0}}" class="o_badge">{{orderCounts.unpaid}}</view>
      </view>
      <view class="order_item" bindtap="goOrders" data-type="3">
        <view class="o_icon">📦</view>
        <view class="o_label">待发货</view>
        <view wx:if="{{orderCounts.shipped > 0}}" class="o_badge">{{orderCounts.shipped}}</view>
      </view>
      <view class="order_item" bindtap="goOrders" data-type="4">
        <view class="o_icon">🚚</view>
        <view class="o_label">待收货</view>
        <view wx:if="{{orderCounts.receiving > 0}}" class="o_badge">{{orderCounts.receiving}}</view>
      </view>
      <view class="order_item" bindtap="goOrders" data-type="5">
        <view class="o_icon">✅</view>
        <view class="o_label">已完成</view>
      </view>
    </view>
  </view>

  <!-- 常用功能 -->
  <view class="card">
    <view class="menu_item" bindtap="goCart">
      <text class="m_icon">🛒</text>
      <text class="m_label">购物车</text>
      <text wx:if="{{cartCount > 0}}" class="m_badge">{{cartCount}}</text>
      <text class="m_arrow">›</text>
    </view>
    <view class="menu_item" bindtap="goCollect">
      <text class="m_icon">❤️</text>
      <text class="m_label">我的收藏</text>
      <text wx:if="{{collectNums > 0}}" class="m_badge">{{collectNums}}</text>
      <text class="m_arrow">›</text>
    </view>
    <view class="menu_item" bindtap="goHistory">
      <text class="m_icon">👣</text>
      <text class="m_label">浏览足迹</text>
      <text class="m_arrow">›</text>
    </view>
    <view class="menu_item" bindtap="goPoints">
      <text class="m_icon">🎯</text>
      <text class="m_label">积分中心</text>
      <text class="m_badge">{{userinfo.points}}分</text>
      <text class="m_arrow">›</text>
    </view>
    <view class="menu_item" bindtap="goCheckin">
      <text class="m_icon">📅</text>
      <text class="m_label">每日签到</text>
      <view wx:if="{{!signedToday}}" class="red_dot"></view>
      <text class="m_arrow">›</text>
    </view>
    <view class="menu_item" bindtap="goCoupon">
      <text class="m_icon">🎟</text>
      <text class="m_label">我的优惠券</text>
      <text wx:if="{{unusedCoupons > 0}}" class="m_badge">{{unusedCoupons}}</text>
      <text class="m_arrow">›</text>
    </view>
    <view class="menu_item" bindtap="goMessage">
      <text class="m_icon">🔔</text>
      <text class="m_label">消息中心</text>
      <view wx:if="{{unreadMessages > 0}}" class="m_badge">{{unreadMessages}}</view>
      <text class="m_arrow">›</text>
    </view>
    <view class="menu_item" bindtap="goAddress">
      <text class="m_icon">📍</text>
      <text class="m_label">收货地址管理</text>
      <text class="m_arrow">›</text>
    </view>
    <view class="menu_item" bindtap="goFeedback">
      <text class="m_icon">💬</text>
      <text class="m_label">意见反馈</text>
      <text class="m_arrow">›</text>
    </view>
    <view class="menu_item">
      <text class="m_icon">📞</text>
      <text class="m_label">联系客服</text>
      <text class="m_arrow">400-618-4000</text>
    </view>
    <view class="menu_item">
      <text class="m_icon">ℹ️</text>
      <text class="m_label">关于我们</text>
      <text class="m_arrow">烧饼工坊 v2.0</text>
    </view>
  </view>

  <view class="footer_tip">烧饼工坊 · 现烤现发 · 坏果包赔</view>
</view>
