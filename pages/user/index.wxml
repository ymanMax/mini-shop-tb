<!--pages/user/index.wxml-->
<view class="page">
  <!-- 用户信息 -->
  <view class="user_header">
    <image class="avatar" src="{{userinfo.avatar || '/static/images/default-avatar.png'}}" mode="aspectFill" binderror="handleImgError" />
    <view class="user_info">
      <view class="nickname">{{userinfo.nickName || '烧饼爱好者'}}</view>
      <view class="user_meta">
        <text class="level">{{userinfo.level || '黄金会员'}}</text>
        <text class="points">{{points}} 积分</text>
      </view>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="card">
    <view class="card_head">
      <text class="card_title">我的订单</text>
      <view class="all_orders" bindtap="goOrder" data-type="0">全部订单 ›</view>
    </view>
    <view class="order_grid">
      <view class="order_item" bindtap="goOrder" data-type="1">
        <text class="order_icon">💰</text>
        <text class="order_label">待付款</text>
        <text class="order_badge" wx:if="{{orderCounts[1] > 0}}">{{orderCounts[1]}}</text>
      </view>
      <view class="order_item" bindtap="goOrder" data-type="2">
        <text class="order_icon">📦</text>
        <text class="order_label">待发货</text>
        <text class="order_badge" wx:if="{{orderCounts[2] > 0}}">{{orderCounts[2]}}</text>
      </view>
      <view class="order_item" bindtap="goOrder" data-type="4">
        <text class="order_icon">🚚</text>
        <text class="order_label">待收货</text>
        <text class="order_badge" wx:if="{{orderCounts[4] > 0}}">{{orderCounts[4]}}</text>
      </view>
      <view class="order_item" bindtap="goOrder" data-type="5">
        <text class="order_icon">✅</text>
        <text class="order_label">已完成</text>
        <text class="order_badge" wx:if="{{orderCounts[5] > 0}}">{{orderCounts[5]}}</text>
      </view>
    </view>
  </view>

  <!-- 常用功能 -->
  <view class="card">
    <view class="func_list">
      <view class="func_item" bindtap="goCoupon">
        <text class="func_icon">🎫</text>
        <text class="func_label">我的优惠券</text>
        <text class="func_value">›</text>
      </view>
      <view class="func_item" bindtap="goPoints">
        <text class="func_icon">⭐</text>
        <text class="func_label">积分中心</text>
        <text class="func_value">{{points}} 分 ›</text>
      </view>
      <view class="func_item" bindtap="goCheckin">
        <text class="func_icon">📅</text>
        <text class="func_label">每日签到</text>
        <text class="func_value">›</text>
      </view>
      <view class="func_item" bindtap="goMessage">
        <text class="func_icon">🔔</text>
        <text class="func_label">消息中心</text>
        <text class="func_value">
          <text wx:if="{{unreadMessages > 0}}" class="msg_badge">{{unreadMessages}}</text>
          ›
        </text>
      </view>
      <view class="func_item" bindtap="goCollect">
        <text class="func_icon">⭐</text>
        <text class="func_label">我的收藏</text>
        <text class="func_value">{{collectNums}} 件 ›</text>
      </view>
      <view class="func_item" bindtap="goHistory">
        <text class="func_icon">🕐</text>
        <text class="func_label">浏览足迹</text>
        <text class="func_value">{{historyCount}} 条 ›</text>
      </view>
      <view class="func_item" bindtap="goAddress">
        <text class="func_icon">📍</text>
        <text class="func_label">收货地址</text>
        <text class="func_value">›</text>
      </view>
      <view class="func_item" bindtap="goCart">
        <text class="func_icon">🛒</text>
        <text class="func_label">购物车</text>
        <text class="func_value">{{cartCount}} 件 ›</text>
      </view>
      <view class="func_item" bindtap="goFeedback">
        <text class="func_icon">💬</text>
        <text class="func_label">意见反馈</text>
        <text class="func_value">›</text>
      </view>
    </view>
  </view>

  <view class="footer_tip">烧饼商城 · 手工现烤 · 坏果包赔</view>
</view>
