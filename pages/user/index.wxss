/* pages/user/index.wxss */
page { background: #f5f5f5; }
.user_page { padding-bottom: 40rpx; }

.user_header {
  background: linear-gradient(135deg, #ff5b6a, #eb4450);
  padding: 60rpx 30rpx 40rpx;
  color: #fff;
  border-radius: 0 0 24rpx 24rpx;
}
.user_row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
}
.user_info { flex: 1; }
.nickname { font-size: 36rpx; font-weight: 700; }
.user_meta { display: flex; gap: 16rpx; margin-top: 8rpx; font-size: 24rpx; opacity: 0.9; }
.points_box { text-align: center; }
.points { font-size: 36rpx; font-weight: 700; }
.points_label { font-size: 22rpx; opacity: 0.9; }

.stats_row {
  display: flex;
  margin-top: 30rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx 0;
}
.stat { flex: 1; text-align: center; }
.stat_num { font-size: 32rpx; font-weight: 700; }
.stat_label { font-size: 22rpx; opacity: 0.9; margin-top: 4rpx; }

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}
.card_title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.all_orders { font-size: 24rpx; color: #999; font-weight: 400; }

.order_grid {
  display: flex;
  justify-content: space-around;
}
.order_item {
  position: relative;
  text-align: center;
  padding: 12rpx 0;
}
.o_icon { font-size: 48rpx; }
.o_label { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.o_badge {
  position: absolute;
  top: 0;
  right: 10rpx;
  background: var(--themeColor);
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 999rpx;
  padding: 0 8rpx;
}

.menu_item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}
.menu_item:last-child { border-bottom: none; }
.m_icon { font-size: 36rpx; margin-right: 16rpx; }
.m_label { flex: 1; color: #333; }
.m_badge {
  background: var(--themeColor);
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 999rpx;
  padding: 0 8rpx;
  margin-right: 16rpx;
}
.m_arrow { color: #ccc; font-size: 28rpx; }
.red_dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--themeColor);
  margin-right: 16rpx;
}

.footer_tip {
  text-align: center;
  color: #999;
  font-size: 22rpx;
  padding: 40rpx 0;
}
