/* pages/user/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.user_header {
  background: linear-gradient(135deg, #eb4450, #ff6b6b);
  padding: 60rpx 32rpx;
  display: flex;
  align-items: center;
  color: #fff;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
}
.user_info { margin-left: 24rpx; }
.nickname { font-size: 36rpx; font-weight: bold; }
.user_meta { margin-top: 8rpx; display: flex; }
.level {
  font-size: 22rpx;
  background: rgba(255,255,255,0.3);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}
.points { font-size: 22rpx; opacity: 0.9; }

.card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.card_head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.card_title { font-size: 30rpx; font-weight: bold; color: #333; }
.all_orders { font-size: 24rpx; color: #999; }

.order_grid {
  display: flex;
  justify-content: space-around;
}
.order_item {
  text-align: center;
  position: relative;
  padding: 12rpx;
}
.order_icon { font-size: 48rpx; display: block; }
.order_label { font-size: 24rpx; color: #333; margin-top: 8rpx; display: block; }
.order_badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #eb4450;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

.func_list { padding: 0 8rpx; }
.func_item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.func_item:last-child { border-bottom: none; }
.func_icon { font-size: 36rpx; margin-right: 16rpx; }
.func_label { flex: 1; font-size: 28rpx; color: #333; }
.func_value { font-size: 24rpx; color: #999; }
.msg_badge {
  display: inline-block;
  background: #eb4450;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
  margin-right: 8rpx;
}

.footer_tip {
  text-align: center;
  color: #bbb;
  font-size: 22rpx;
  padding: 40rpx 0;
}
