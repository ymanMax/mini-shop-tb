/* pages/goods_detail/index.wxss */
page {
  background: #f5f5f5;
  padding-bottom: 140rpx;
}
.detail_page { padding-bottom: 140rpx; }

/* 媒体区 */
.media {
  position: relative;
  width: 100%;
  height: 75vw;
  background: #000;
}
.media swiper { width: 100%; height: 100%; }
.media swiper image { width: 100%; height: 100%; }
.swiper_indicator {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

/* 价格卡片 */
.price_card {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.price_row {
  display: flex;
  align-items: baseline;
}
.price.big {
  font-size: 48rpx;
  font-weight: 700;
}
.price.big .price-symbol { font-size: 28rpx; }
.price-origin {
  margin-left: 16rpx;
  font-size: 26rpx;
}
.sales_text {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}
.goods_name {
  font-size: 32rpx;
  font-weight: 600;
  margin: 16rpx 0;
  line-height: 44rpx;
}
.tag_row { min-height: 36rpx; }

/* 售后 */
.aftersale_row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}
.as_item {
  font-size: 24rpx;
  color: #666;
  background: #f9f9f9;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

/* SKU 入口 */
.sku_entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sku_entry_label {
  font-size: 28rpx;
  color: #999;
}
.sku_entry_value {
  font-size: 28rpx;
  color: #333;
}

/* 参数 */
.section_title {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.toggle_arrow { font-size: 24rpx; color: #999; font-weight: 400; }
.params_list, .params_collapsed { margin-top: 16rpx; }
.param_row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 26rpx;
}
.param_key { width: 160rpx; color: #999; }
.param_val { flex: 1; color: #333; }

/* 图文详情 */
.desc_text {
  font-size: 28rpx;
  color: #444;
  line-height: 44rpx;
  margin: 16rpx 0;
}
.detail_img {
  width: 100%;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
}

/* 评价 */
.review_summary {
  display: flex;
  gap: 32rpx;
  margin: 20rpx 0;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}
.avg_block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
}
.avg_score {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--themeColor);
}
.avg_total { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.distribution { flex: 1; }
.dist_row {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}
.dist_star { width: 60rpx; }
.dist_bar {
  flex: 1;
  height: 12rpx;
  background: #eee;
  border-radius: 6rpx;
  margin: 0 12rpx;
  overflow: hidden;
}
.dist_fill {
  height: 100%;
  background: #ffb400;
  border-radius: 6rpx;
}
.dist_pct { width: 60rpx; text-align: right; }

.review_filters {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.rf_item {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 999rpx;
}
.rf_item.active {
  color: #fff;
  background: var(--themeColor);
}

.review_item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.review_head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.review_avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}
.review_user { flex: 1; }
.review_name { font-size: 26rpx; font-weight: 600; }
.review_time { font-size: 22rpx; color: #999; }
.review_tags { margin: 10rpx 0; }
.review_content {
  font-size: 28rpx;
  color: #333;
  line-height: 42rpx;
  margin: 10rpx 0;
}
.review_imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 12rpx 0;
}
.review_img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}
.review_spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.toggle_all {
  text-align: center;
  color: var(--themeColor);
  font-size: 26rpx;
  padding: 20rpx 0;
}
.empty-state.small { padding: 60rpx 40rpx; }

/* 推荐 */
.recommend_scroll { white-space: nowrap; margin-top: 16rpx; }
.rec_item {
  display: inline-block;
  width: 200rpx;
  margin-right: 16rpx;
  vertical-align: top;
}
.rec_item image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}
.rec_name {
  font-size: 24rpx;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 34rpx;
}
.rec_price { font-size: 28rpx; font-weight: 600; }

/* 底部操作栏 */
.bottom_bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 80;
}
.bb_item {
  flex: 0 0 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 20rpx;
  color: #666;
  position: relative;
}
.bb_icon { font-size: 36rpx; }
.bb_badge {
  position: absolute;
  top: -6rpx;
  right: 12rpx;
  background: var(--themeColor);
  color: #fff;
  font-size: 18rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 999rpx;
  padding: 0 8rpx;
}
.bb_btn {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-cart { background: linear-gradient(90deg, #ffb400, #ff9500); }
.btn-buy { background: linear-gradient(90deg, #ff5b6a, #eb4450); }

/* SKU 弹层 */
.sku_sheet { max-height: 85vh; }
.sku_head {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}
.sku_img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-top: -40rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}
.sku_head_info {
  flex: 1;
  margin-left: 24rpx;
  padding-top: 20rpx;
}
.sku_price { font-size: 40rpx; font-weight: 700; }
.sku_stock { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.sku_selected { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.sku_close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  font-size: 36rpx;
  color: #999;
}
.sku_body {
  padding: 24rpx;
  max-height: 50vh;
}
.sku_spec_group { margin-bottom: 24rpx; }
.spec_name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.spec_options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.spec_opt {
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #333;
  border: 2rpx solid transparent;
}
.spec_opt.active {
  background: var(--themeLight);
  color: var(--themeColor);
  border-color: var(--themeColor);
  font-weight: 600;
}
.opt_price { font-size: 22rpx; color: #ff9500; margin-left: 4rpx; }
.sku_count_row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}
.sku_footer {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.sku_confirm {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}

/* 骨架屏 */
.detail_skeleton { padding: 24rpx; }
.sk_media { width: 100%; height: 75vw; border-radius: 16rpx; margin-bottom: 20rpx; }
.sk_block { background: #fff; padding: 24rpx; border-radius: 16rpx; margin-bottom: 20rpx; }
.sk_line { height: 28rpx; margin-bottom: 16rpx; border-radius: 6rpx; }
.sk_line.w60 { width: 60%; }
.sk_line.w90 { width: 90%; }
.sk_line.w40 { width: 40%; }
.sk_card { height: 120rpx; border-radius: 16rpx; margin-bottom: 20rpx; }

/* 分享按钮重置 */
.bb_share {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}
.bb_share::after { border: none; }
