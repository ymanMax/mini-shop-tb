/* pages/goods_detail/index.wxss */
page {
  background: #f5f5f5;
  padding-bottom: 120rpx;
}
.detail_page {
  padding-bottom: 40rpx;
}

/* 媒体区 */
.media_area {
  position: relative;
  width: 100%;
  height: 750rpx;
  background: #fff;
}
.main_swiper {
  width: 100%;
  height: 100%;
}
.main_swiper image {
  width: 100%;
  height: 100%;
}
.pic_indicator {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

/* 价格卡片 */
.price_card {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.price_row {
  display: flex;
  align-items: baseline;
}
.now_price {
  color: #eb4450;
  font-size: 48rpx;
  font-weight: bold;
}
.original_price {
  color: #999;
  font-size: 26rpx;
  text-decoration: line-through;
  margin-left: 16rpx;
}
.sales_text {
  margin-left: auto;
  color: #999;
  font-size: 24rpx;
}
.goods_name {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-top: 16rpx;
  line-height: 1.5;
}
.tag_row {
  margin-top: 16rpx;
}
.tag_capsule {
  display: inline-block;
  font-size: 22rpx;
  color: #eb4450;
  border: 1rpx solid #eb4450;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
}

/* 区块卡片 */
.section_card {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.section_title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.arrow {
  font-size: 24rpx;
  color: #999;
}

/* 参数 */
.params_list {
  margin-top: 8rpx;
}
.param_row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.param_key {
  width: 160rpx;
  color: #999;
  font-size: 26rpx;
}
.param_value {
  flex: 1;
  color: #333;
  font-size: 26rpx;
}

/* 售后 */
.aftersale_row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.aftersale_icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}
.aftersale_text {
  font-size: 26rpx;
  color: #666;
}

/* 图文详情 */
.detail_desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 16rpx;
}
.detail_img {
  width: 100%;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}

/* 评价 */
.rating_summary {
  display: flex;
  padding: 16rpx 0;
}
.rating_left {
  width: 200rpx;
  text-align: center;
}
.rating_num {
  font-size: 56rpx;
  font-weight: bold;
  color: #eb4450;
}
.rating_stars {
  margin: 8rpx 0;
}
.star {
  color: #ddd;
  font-size: 28rpx;
}
.star.on {
  color: #ffb400;
}
.rating_count {
  font-size: 22rpx;
  color: #999;
}
.rating_dist {
  flex: 1;
  padding-left: 32rpx;
}
.dist_row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.dist_label {
  width: 60rpx;
  font-size: 22rpx;
  color: #999;
}
.dist_bar_wrap {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  margin: 0 16rpx;
}
.dist_bar {
  height: 100%;
  background: #ffb400;
  border-radius: 6rpx;
}
.dist_pct {
  width: 80rpx;
  font-size: 22rpx;
  color: #999;
  text-align: right;
}

/* 评价筛选 */
.review_filter_bar {
  white-space: nowrap;
  margin: 16rpx 0;
}
.review_filter_inner {
  display: inline-flex;
}
.rf_tag {
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
  background: #f2f2f2;
}
.rf_tag.active {
  background: #eb4450;
  color: #fff;
}

/* 评价列表 */
.review_item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.review_head {
  display: flex;
  align-items: center;
}
.review_avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eee;
}
.review_user {
  margin-left: 16rpx;
  flex: 1;
}
.review_name {
  font-size: 26rpx;
  color: #333;
}
.review_stars {
  margin-top: 4rpx;
}
.review_time {
  font-size: 22rpx;
  color: #999;
}
.review_tags {
  margin: 12rpx 0;
}
.review_tag {
  display: inline-block;
  font-size: 20rpx;
  color: #ffb400;
  background: #fff7e6;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
}
.review_content {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
}
.review_images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.review_img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.review_spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.view_all {
  text-align: center;
  color: #eb4450;
  font-size: 26rpx;
  padding: 24rpx 0;
}

/* 推荐 */
.recommend_bar {
  white-space: nowrap;
}
.recommend_inner {
  display: inline-flex;
}
.recommend_item {
  width: 200rpx;
  margin-right: 20rpx;
}
.recommend_img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}
.recommend_name {
  font-size: 24rpx;
  color: #333;
  margin-top: 8rpx;
}
.recommend_price {
  color: #eb4450;
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 4rpx;
}

/* 底部操作栏 */
.bottom_bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 50;
}
.bar_icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}
.icon_wrap {
  position: relative;
}
.bar_icon_font {
  font-size: 40rpx;
}
.bar_icon_font.collected {
  color: #eb4450;
}
.bar_label {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}
.bar_btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #fff;
  margin-left: 16rpx;
}
.btn_cart {
  background: linear-gradient(90deg, #ffb400, #ff9500);
}
.btn_buy {
  background: linear-gradient(90deg, #ff5a66, #eb4450);
}

/* SKU 弹层 */
.sku_mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  transition: opacity 0.3s;
}
.sku_mask.show {
  opacity: 1;
}
.sku_panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s;
  max-height: 80vh;
  overflow-y: auto;
}
.sku_panel.show {
  transform: translateY(0);
}
.sku_head {
  display: flex;
  position: relative;
  margin-bottom: 24rpx;
}
.sku_img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #eee;
}
.sku_head_info {
  margin-left: 24rpx;
  flex: 1;
}
.sku_price {
  color: #eb4450;
  font-size: 44rpx;
  font-weight: bold;
}
.sku_stock {
  color: #999;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.sku_selected {
  color: #666;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.sku_close {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}
.sku_specs {
  margin-bottom: 24rpx;
}
.sku_spec_name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.sku_values {
  display: flex;
  flex-wrap: wrap;
}
.sku_value {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #f2f2f2;
  font-size: 26rpx;
  color: #333;
}
.sku_value.active {
  background: #eb4450;
  color: #fff;
}
.sku_count_row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.stepper {
  display: flex;
  align-items: center;
}
.stepper_btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #f2f2f2;
  border-radius: 8rpx;
  font-size: 32rpx;
}
.stepper_input {
  width: 100rpx;
  height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  margin: 0 12rpx;
  background: #f2f2f2;
  border-radius: 8rpx;
}
.sku_btns {
  display: flex;
}
.sku_btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  color: #fff;
}
.sku_btn.btn_cart {
  background: linear-gradient(90deg, #ffb400, #ff9500);
  margin-right: 20rpx;
}
.sku_btn.btn_buy {
  background: linear-gradient(90deg, #ff5a66, #eb4450);
}
