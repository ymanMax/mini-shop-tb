/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.search_bar {
  padding: 16rpx 24rpx;
  background: #fff;
}
.search_inner {
  display: flex;
  align-items: center;
  background: #f2f2f2;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
}
.search_icon { margin-right: 12rpx; font-size: 28rpx; }
.search_placeholder { color: #999; font-size: 26rpx; }

.swiper {
  width: 100%;
  height: 320rpx;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
}
.swiper_img { width: 100%; height: 320rpx; border-radius: 16rpx; }

/* 分类导航 */
.cate_nav {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
}
.cate_item {
  width: 25%;
  text-align: center;
  padding: 16rpx 0;
}
.cate_icon { font-size: 48rpx; display: block; }
.cate_name { font-size: 24rpx; color: #333; margin-top: 8rpx; display: block; }

/* 楼层 */
.floor {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.floor_title {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.floor_icon { font-size: 32rpx; margin-right: 12rpx; }
.floor_name { font-size: 30rpx; font-weight: bold; color: #333; }
.floor_scroll { white-space: nowrap; }
.floor_goods {
  display: inline-block;
  width: 200rpx;
  margin-right: 16rpx;
  vertical-align: top;
}
.floor_img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}
.floor_goods_name {
  font-size: 24rpx;
  color: #333;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.floor_price {
  color: #eb4450;
  font-size: 26rpx;
  font-weight: bold;
  margin-top: 4rpx;
}

/* 骨架屏 */
.skeleton { padding: 24rpx; }
.sk_banner {
  width: 100%;
  height: 320rpx;
  background: #eee;
  border-radius: 16rpx;
}
.sk_row {
  height: 120rpx;
  background: #eee;
  border-radius: 16rpx;
  margin-top: 20rpx;
}
.breath { animation: breath 1.2s infinite ease-in-out; }
@keyframes breath {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.bottom_space { height: 40rpx; }

/* 限时抢购 */
.seckill_section {
  background: linear-gradient(135deg, #fff5f5, #fff);
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.seckill_head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.seckill_title {
  font-size: 32rpx;
  font-weight: bold;
  color: #eb4450;
}
.seckill_icon { margin-right: 8rpx; }
.seckill_countdown {
  display: flex;
  align-items: center;
  background: #eb4450;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}
.cd_label { font-size: 22rpx; margin-right: 8rpx; }
.cd_time { font-size: 26rpx; font-weight: bold; font-family: monospace; }
.session_tabs {
  display: flex;
  margin-bottom: 16rpx;
}
.session_tab {
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 20rpx;
}
.session_tab.active {
  background: #eb4450;
  color: #fff;
  font-weight: bold;
}
.seckill_scroll { white-space: nowrap; }
.seckill_card {
  display: inline-block;
  width: 220rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  vertical-align: top;
}
.seckill_img {
  width: 100%;
  height: 180rpx;
  border-radius: 8rpx;
}
.seckill_price_row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.seckill_price {
  color: #eb4450;
  font-size: 32rpx;
  font-weight: bold;
}
.seckill_origin {
  color: #999;
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 8rpx;
}
.seckill_progress {
  margin-top: 8rpx;
}
.progress_track {
  width: 100%;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress_fill {
  height: 100%;
  background: linear-gradient(90deg, #eb4450, #ff6b6b);
  border-radius: 6rpx;
}
.progress_text {
  font-size: 20rpx;
  color: #eb4450;
  margin-top: 4rpx;
  display: block;
}
.seckill_stock {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
.seckill_buy {
  margin-top: 8rpx;
  text-align: center;
  background: #eb4450;
  color: #fff;
  padding: 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
