/* pages/index/index.wxss */
page {
  background: #f5f5f5;
}
.index_page {
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search_bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search_inner {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f2f2f2;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
}
.search_icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}
.search_placeholder {
  color: #999;
  font-size: 26rpx;
}
.cart_entry {
  position: relative;
  margin-left: 24rpx;
  padding: 8rpx;
}
.cart_icon {
  font-size: 40rpx;
}

/* 轮播 */
.main_swiper {
  width: 100%;
  height: 340rpx;
}
.main_swiper image {
  width: 100%;
  height: 100%;
}

/* 分类导航 */
.cate_nav {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
}
.cate_item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.cate_icon {
  font-size: 56rpx;
}
.cate_name {
  font-size: 24rpx;
  color: #333;
  margin-top: 8rpx;
}

/* 楼层 */
.floor_section {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.floor_title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.floor_icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.floor_name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}
.floor_more {
  font-size: 24rpx;
  color: #999;
}
.floor_goods {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.floor_goods_item {
  width: 48%;
  margin-bottom: 20rpx;
}
.floor_img {
  width: 100%;
  height: 280rpx;
  border-radius: 12rpx;
}
.floor_goods_name {
  font-size: 26rpx;
  color: #333;
  margin-top: 8rpx;
}
.floor_goods_price {
  color: #eb4450;
  font-size: 30rpx;
  font-weight: bold;
  margin-top: 4rpx;
}

/* 骨架屏 */
.skeleton_page {
  padding: 24rpx;
}
.skeleton_banner {
  width: 100%;
  height: 340rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.skeleton_row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.skeleton_cate {
  width: 25%;
  height: 120rpx;
  margin-bottom: 16rpx;
}
.skeleton_floor {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
}

/* ============ 限时抢购 ============ */
.seckill_section {
  background: linear-gradient(180deg, #fff5f5, #fff);
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.seckill_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.seckill_title {
  display: flex;
  align-items: center;
}
.seckill_icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}
.seckill_name {
  font-size: 34rpx;
  font-weight: bold;
  color: #eb4450;
}
.seckill_countdown {
  display: flex;
  align-items: center;
}
.countdown_label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}
.countdown_time {
  font-size: 30rpx;
  font-weight: bold;
  color: #eb4450;
  font-family: monospace;
}
.session_bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.session_inner {
  display: inline-flex;
}
.session_tab {
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #f2f2f2;
  text-align: center;
}
.session_tab.active {
  background: #eb4450;
  color: #fff;
}
.session_time {
  font-size: 28rpx;
  font-weight: bold;
}
.session_label {
  font-size: 20rpx;
  opacity: 0.8;
}
.seckill_list {
  white-space: nowrap;
}
.seckill_inner {
  display: inline-flex;
}
.seckill_card {
  width: 240rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.seckill_img {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
}
.seckill_info {
  margin-top: 12rpx;
}
.seckill_name {
  font-size: 24rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.seckill_price_row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}
.seckill_price {
  color: #eb4450;
  font-size: 32rpx;
  font-weight: bold;
}
.seckill_original {
  color: #999;
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 8rpx;
}
.progress_wrap {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.progress_bar {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress_fill {
  height: 100%;
  background: linear-gradient(90deg, #ff5a66, #ff9500);
  border-radius: 6rpx;
}
.progress_text {
  font-size: 20rpx;
  color: #eb4450;
  margin-left: 8rpx;
}
.seckill_stock {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
.seckill_btn {
  margin-top: 12rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: linear-gradient(90deg, #ff5a66, #eb4450);
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
}
.seckill_btn.disabled {
  background: #ccc;
}

/* ============ 抢购 SKU 弹层 ============ */
.sku_mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  opacity: 0;
  transition: opacity 0.3s;
}
.sku_mask.show { opacity: 1; }
.sku_panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s;
  max-height: 80vh;
  overflow-y: auto;
}
.sku_panel.show { transform: translateY(0); }
.sku_head {
  display: flex;
  position: relative;
  margin-bottom: 24rpx;
}
.sku_img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #eee;
}
.sku_head_info { margin-left: 24rpx; flex: 1; }
.sku_price { color: #eb4450; font-size: 44rpx; font-weight: bold; }
.sku_stock { color: #999; font-size: 24rpx; margin-top: 8rpx; }
.sku_selected { color: #666; font-size: 24rpx; margin-top: 8rpx; }
.sku_close {
  position: absolute; right: 0; top: 0;
  font-size: 36rpx; color: #999; padding: 8rpx;
}
.sku_specs { margin-bottom: 24rpx; }
.sku_spec_name { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.sku_values { display: flex; flex-wrap: wrap; }
.sku_value {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #f2f2f2;
  font-size: 26rpx;
  color: #333;
}
.sku_value.active { background: #eb4450; color: #fff; }
.sku_count_row {
  display: flex; align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.stepper { display: flex; align-items: center; }
.stepper_btn {
  width: 64rpx; height: 64rpx; line-height: 64rpx;
  text-align: center; background: #f2f2f2; border-radius: 8rpx; font-size: 32rpx;
}
.stepper_num {
  width: 100rpx; height: 64rpx; line-height: 64rpx;
  text-align: center; font-size: 28rpx; margin: 0 12rpx;
  background: #f2f2f2; border-radius: 8rpx;
}
.sku_btns { display: flex; }
.sku_btn {
  flex: 1; height: 88rpx; line-height: 88rpx;
  text-align: center; border-radius: 999rpx;
  font-size: 30rpx; color: #fff;
}
.sku_btn.btn_buy { background: linear-gradient(90deg, #ff5a66, #eb4450); }
