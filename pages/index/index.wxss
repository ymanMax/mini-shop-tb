/* pages/index/index.wxss */
page { background: #f5f5f5; }
.home_page { padding-bottom: 40rpx; }

.banner {
  height: 340rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.banner swiper { width: 100%; height: 100%; }
.banner image { width: 100%; height: 100%; }
.banner_title {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* ===== 限时抢购 ===== */
.seckill_section {
  background: linear-gradient(135deg, #fff5f5, #fff);
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #ffe0e0;
}
.seckill_head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.seckill_title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--themeColor);
  flex: 1;
}
.countdown {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ffd0d0;
}
.cd_label { font-size: 22rpx; color: #999; }
.cd_time {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--themeColor);
  font-family: monospace;
}
.seckill_more { font-size: 24rpx; color: #999; margin-left: 16rpx; }

.session_bar { white-space: nowrap; margin-bottom: 16rpx; }
.session_item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  text-align: center;
}
.session_item.active {
  background: var(--themeColor);
  color: #fff;
}
.session_hour { font-size: 28rpx; font-weight: 700; }
.session_name { font-size: 20rpx; opacity: 0.9; }

.seckill_scroll { white-space: nowrap; }
.seckill_card {
  display: inline-block;
  width: 220rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx;
  vertical-align: top;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.seckill_card image {
  width: 100%;
  height: 180rpx;
  border-radius: 8rpx;
}
.sk_name {
  font-size: 24rpx;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 32rpx;
  height: 64rpx;
}
.sk_price_row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin: 4rpx 0;
}
.sk_price { font-size: 32rpx; font-weight: 800; color: var(--themeColor); }
.sk_orig { font-size: 22rpx; color: #999; text-decoration: line-through; }
.progress_bar {
  height: 12rpx;
  background: #ffe0e0;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress_fill {
  height: 100%;
  background: linear-gradient(90deg, #ff5b6a, #ff9500);
  border-radius: 6rpx;
}
.sk_meta {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #999;
  margin: 6rpx 0;
}
.sk_buy {
  text-align: center;
  background: linear-gradient(90deg, #ff5b6a, #eb4450);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx;
  border-radius: 999rpx;
}
.sk_buy.soldout {
  background: #ccc;
}

/* ===== 分类导航 ===== */
.cate_nav {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
}
.cate_item {
  width: 25%;
  text-align: center;
  padding: 16rpx 0;
}
.cate_icon { font-size: 48rpx; }
.cate_name { font-size: 24rpx; color: #333; margin-top: 8rpx; }

/* ===== 楼层 ===== */
.floors { margin: 0 20rpx 20rpx; }
.floor_title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
}
.floor_icon { font-size: 36rpx; }
.floor_name { font-size: 32rpx; font-weight: 700; color: #333; }
.floor_goods {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.floor_goods_item {
  width: 32%;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.floor_goods_item image {
  width: 100%;
  height: 200rpx;
}
.fg_name {
  font-size: 24rpx;
  padding: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 34rpx;
  min-height: 68rpx;
}
.fg_price {
  font-size: 28rpx;
  font-weight: 700;
  padding: 0 8rpx 12rpx;
}

.home_footer {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 40rpx 0;
}

/* 骨架屏 */
.home_skeleton { padding: 20rpx; }
.sk_banner { height: 340rpx; border-radius: 16rpx; margin-bottom: 20rpx; }
.sk_seckill { height: 280rpx; border-radius: 16rpx; margin-bottom: 20rpx; }
.sk_cates { height: 200rpx; border-radius: 16rpx; margin-bottom: 20rpx; }
.sk_floor { height: 400rpx; border-radius: 16rpx; }
